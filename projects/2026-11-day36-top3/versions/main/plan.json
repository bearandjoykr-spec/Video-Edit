 "captions": [
  {
   "s": 1.95,
   "e": 5.9,
   "text": "교구와 그림책 TOP 3,\n함께 소개해드릴게요",
   "ko": "",
   "who": "Joy"
  },
  {
   "s": 5.95,
   "e": 7.55,
   "text": "Come on! Let's go!",
   "ko": "",
   "who": "Mark"
  },
  {
   "s": 9.05,
   "e": 12.319,
   "text": "사람이 제일 많았던 곳,\n바로 영어책 코너!",
   "vo": true
  },
  {
   "s": 12.319,
   "e": 16.154,
   "text": "소리책, 팝업북도 좋지만\n고를 땐 꼭 펼쳐 보세요",
   "vo": true
  },
  {
   "s": 16.154,
   "e": 19.989,
   "text": "바로 말해 줄 문장이 있는 책이\n제일 오래 쓰여요",
   "vo": true
  },
  {
   "s": 21.5,
   "e": 25.901,
   "text": "아이들은 앉아서 공부할 때보다\n놀 때 훨씬 빨리 배워요",
   "vo": true
  },
  {
   "s": 25.901,
   "e": 28.226,
   "text": "놀면서 이렇게 말해 주세요",
   "vo": true
  },
  {
   "s": 28.0,
   "e": 29.5,
   "text": "Kick the ball!",
   "ko": "공을 차!",
   "phrase": true
  },
  {
   "s": 29.5,
   "e": 31.0,
   "text": "Throw it to me!",
   "ko": "나한테 던져!",
   "phrase": true
  },
  {
   "s": 31.0,
   "e": 32.5,
   "text": "Catch!",
   "ko": "잡아!",
   "phrase": true
  },
  {
   "s": 32.5,
   "e": 34.0,
   "text": "Your turn!",
   "ko": "네 차례야!",
   "phrase": true
  },
  {
   "s": 34.05,
   "e": 37.8,
   "text": "They're not just on their fingers,\nthey're actually jumping up and down!",
   "ko": "손가락만 쓰는 게 아니라, 온몸으로 뛰면서 놀아요!",
   "who": "Mark"
  },
  {
   "s": 39.3,
   "e": 43.324,
   "text": "직접 누르면 소리가 나서\n새 단어를 스스로 익혀요",
   "vo": true
  },
  {
   "s": 43.324,
   "e": 46.592,
   "text": "집이나 어린이집\n환경 구성에 딱이에요",
   "vo": true
  },
  {
   "s": 46.55,
   "e": 47.3,
   "text": "Brilliant! 👏",
   "ko": "",
   "who": "Mark"
  },
  {
   "s": 47.3,
   "e": 50.003,
   "text": "저장해 두고\n아이랑 꼭 해 보세요!",
   "vo": true
  }
 ],
