 "captions": [
  {
   "s": 5.0,
   "e": 8.7,
   "ko": "Little Steps 첫날에 오신 걸 환영해요!",
   "hi": "첫날"
  },
  {
   "s": 8.7,
   "e": 12.7,
   "ko": "오늘은 세 가지 짧은 영어 표현을 연습해 볼 거예요.",
   "hi": "세 가지"
  },
  {
   "s": 12.7,
   "e": 17.84,
   "ko": "그다음 조이가 아이와 놀이하면서 이 표현들을 어떻게 활용하는지 보여드릴게요.",
   "hi": "놀이",
   "left": 600
  },
  {
   "s": 17.84,
   "e": 21.94,
   "ko": "처음부터 모든 걸 기억하려고 하지 않으셔도 돼요.",
   "hi": "모든 걸"
  },
  {
   "s": 21.94,
   "e": 25.4,
   "ko": "언제든 다시 돌아와 저와 함께 연습하시면 됩니다.",
   "hi": "언제든"
  },
  {
   "s": 25.5,
   "e": 28.6,
   "ko": "준비되셨나요? 그럼 시작해 볼까요?",
   "hi": "시작"
  },
  {
   "s": 32.6,
   "e": 34.6,
   "ko": "첫 번째 표현은 바로 이거예요.",
   "hi": "첫 번째"
  },
  {
   "s": 39.6,
   "e": 41.7,
   "ko": "한 번 더 들어보세요.",
   "hi": "한 번 더"
  },
  {
   "s": 45.5,
   "e": 47.4,
   "ko": "이번엔 직접 따라 해보세요.",
   "hi": "직접"
  },
  {
   "s": 48.3,
   "e": 52.2,
   "ko": "‘it’s a’는 끊지 않고 자연스럽게 이어서 말해 보세요.",
   "hi": "이어서"
  },
  {
   "s": 54.6,
   "e": 57.9,
   "ko": "그리고 ‘Look!’은 반가운 무언가를 발견한 것처럼",
   "hi": "발견"
  },
  {
   "s": 57.9,
   "e": 61.0,
   "ko": "조금 신나는 목소리로 말해 보세요.",
   "hi": "신나는"
  },
  {
   "s": 72.0,
   "e": 73.7,
   "ko": "다음 표현은 이거예요.",
   "hi": "다음"
  },
  {
   "s": 77.0,
   "e": 81.1,
   "ko": "‘Where’s’는 ‘Where is’를 줄인 표현이에요.",
   "hi": "줄인"
  },
  {
   "s": 81.2,
   "e": 84.0,
   "ko": "하나의 단어처럼 자연스럽게 말해 보세요.",
   "hi": "하나의 단어"
  },
  {
   "s": 86.9,
   "e": 88.7,
   "ko": "이번엔 여러분 차례예요.",
   "hi": "여러분"
  },
  {
   "s": 90.5,
   "e": 91.75,
   "ko": "좋아요!",
   "hi": ""
  },
  {
   "s": 91.78,
   "e": 95.5,
   "ko": "궁금해하는 느낌을 목소리에 담아보세요.",
   "hi": "궁금해하는"
  },
  {
   "s": 95.6,
   "e": 98.2,
   "ko": "아이와 함께 곰을 찾고 있는 거예요.",
   "hi": "함께"
  },
  {
   "s": 103.8,
   "e": 105.05,
   "ko": "아주 잘했어요!",
   "hi": ""
  },
  {
   "s": 107.9,
   "e": 110.7,
   "ko": "그리고 곰을 찾았을 땐 이렇게 말해요.",
   "hi": "찾았을 땐"
  },
  {
   "s": 112.2,
   "e": 114.2,
   "ko": "다시 한번 들어보세요.",
   "hi": "다시"
  },
  {
   "s": 116.45,
   "e": 118.2,
   "ko": "이번엔 직접 따라 해보세요.",
   "hi": "직접"
  },
  {
   "s": 120.5,
   "e": 121.75,
   "ko": "아주 잘했어요!",
   "hi": ""
  },
  {
   "s": 121.8,
   "e": 124.2,
   "ko": "웃는 듯한 밝은 목소리로 말해 보세요.",
   "hi": "밝은"
  },
  {
   "s": 124.3,
   "e": 126.9,
   "ko": "드디어 곰을 찾았으니까요!",
   "hi": "찾았으니까요"
  },
  {
   "s": 131.8,
   "e": 133.03,
   "ko": "좋아요!",
   "hi": ""
  },
  {
   "s": 133.05,
   "e": 136.5,
   "ko": "이제 세 가지 표현을 함께 연습해 볼게요.",
   "hi": "세 가지"
  },
  {
   "s": 150.7,
   "e": 155.9,
   "ko": "좋아요! 이제 배운 표현들을 실제 놀이에서 사용해 볼 차례예요.",
   "hi": "놀이"
  },
  {
   "s": 156.2,
   "e": 158.4,
   "ko": "그럼 이제 조이에게 넘겨볼게요!",
   "hi": "조이"
  },
  {
   "s": 160.0,
   "e": 163.1,
   "ko": "마크와 오늘의 세 문장 연습 잘 해보셨나요?",
   "hi": "세 문장"
  },
  {
   "s": 163.3,
   "e": 167.0,
   "ko": "이제 이 문장들을 아이와 놀면서 한번 사용해 볼게요.",
   "hi": "놀면서"
  },
  {
   "s": 167.4,
   "e": 170.8,
   "ko": "오늘은 아주 작은 창문 뒤에 곰을 숨겼다가",
   "hi": "창문"
  },
  {
   "s": 170.8,
   "e": 173.6,
   "ko": "까꿍 하고 보여주는 놀이예요.",
   "hi": "까꿍"
  },
  {
   "s": 173.8,
   "e": 178.0,
   "ko": "이 워크시트는 놀이 전에 우리 부모님께서 미리 잘라주세요.",
   "hi": "미리"
  },
  {
   "s": 178.2,
   "e": 183.0,
   "ko": "창문의 양옆에 접는 부분과 곰 아래의 넓은 손잡이는 남겨주세요.",
   "hi": "남겨주세요"
  },
  {
   "s": 183.3,
   "e": 188.4,
   "ko": "놀이할 때도 부모님이 손잡이를 잡고 곰과 창문을 움직여주시면 돼요.",
   "hi": "손잡이"
  },
  {
   "s": 188.6,
   "e": 191.3,
   "ko": "자, 그럼 먼저 아이에게 곰을 보여주세요.",
   "hi": "곰"
  },
  {
   "s": 196.4,
   "e": 201.8,
   "ko": "이번에는 곰 그림을 창문 종이 뒤로 쏙 숨기고 창문을 닫아볼게요.",
   "hi": "쏙"
  },
  {
   "s": 206.7,
   "e": 209.5,
   "ko": "그리고 창문을 열면…",
   "hi": "열면"
  },
  {
   "s": 219.0,
   "e": 222.5,
   "ko": "이렇게만 해도 짧은 놀이 하나가 완성돼요.",
   "hi": "완성"
  },
  {
   "s": 222.9,
   "e": 225.3,
   "ko": "아이가 좋아한다면 한 번 더 해보세요.",
   "hi": "한 번 더"
  },
  {
   "s": 225.5,
   "e": 227.8,
   "ko": "이번에는 작은 목소리로",
   "hi": "작은 목소리"
  },
  {
   "s": 236.2,
   "e": 241.3,
   "ko": "같은 문장도 목소리와 표정이 달라지면 새로운 재미가 생겨요.",
   "hi": "새로운 재미"
  },
  {
   "s": 241.4,
   "e": 246.1,
   "ko": "우리 아이가 웃었던 부분이 있다면 그 부분을 다시 해주세요.",
   "hi": "웃었던"
  },
  {
   "s": 246.2,
   "e": 250.7,
   "ko": "아직 아기라면 부모님이 질문도 하고 대답도 하며 보여주세요.",
   "hi": "아기"
  },
  {
   "s": 250.7,
   "e": 254.9,
   "ko": "아이가 꼭 따라 말하거나 곰을 찾아야 하는 건 아니에요.",
   "hi": "꼭"
  },
  {
   "s": 255.0,
   "e": 259.7,
   "ko": "영어가 이미 익숙한 아이라면 아이가 원할 때 질문하는 역할을 맡겨보세요.",
   "hi": "질문하는 역할"
  },
  {
   "s": 259.7,
   "e": 264.5,
   "ko": "아이가 “Where’s the bear?”라고 물으면 창문을 열어주세요.",
   "hi": "창문"
  },
  {
   "s": 264.6,
   "e": 267.5,
   "ko": "아이가 한국어로 “여기!”라고 말해도 좋아요.",
   "hi": "“여기!”"
  },
  {
   "s": 267.6,
   "e": 272.5,
   "ko": "받아주면서 “Yes! Right! There he is!”라고 말해주세요.",
   "hi": "받아주면서"
  },
  {
   "s": 272.6,
   "e": 277.9,
   "ko": "꼭 영어로 다시 한번 말해봐, 영어로 뭐라고 했지? 라고 확인하지 않으셔도 돼요.",
   "hi": "확인"
  },
  {
   "s": 278.1,
   "e": 281.3,
   "ko": "저희 베어앤조이가 중요하게 생각하는 건",
   "hi": "중요하게"
  },
  {
   "s": 281.3,
   "e": 284.9,
   "ko": "영어를 가르치려고 하기보다는 함께 사용하는 거예요.",
   "hi": "함께"
  },
  {
   "s": 285.1,
   "e": 291.1,
   "ko": "우리말로 까꿍 놀이를 할 때 아이에게 정답을 말하게 하려고 놀지는 않잖아요.",
   "hi": "정답"
  },
  {
   "s": 291.2,
   "e": 294.9,
   "ko": "서로의 반응을 보고 웃으며 함께 하려는 거죠.",
   "hi": "웃으며"
  },
  {
   "s": 295.0,
   "e": 297.5,
   "ko": "영어도 그렇게 사용해 볼 수 있어요.",
   "hi": "영어도"
  },
  {
   "s": 297.6,
   "e": 304.0,
   "ko": "부모님이 편하게 시도해보고 실수해도 웃으며 다시 해보는 모습을 보여주세요.",
   "hi": "실수해도"
  },
  {
   "s": 304.2,
   "e": 309.9,
   "ko": "아이에게도 “나도 한번 해봐도 괜찮겠구나”라는 마음이 생길 수 있도록요.",
   "hi": "괜찮겠구나"
  },
  {
   "s": 310.1,
   "e": 315.9,
   "ko": "그렇게 부모님과 아이 모두 영어를 사용하는 데 조금씩 자신감을 쌓아가는 거예요.",
   "hi": "자신감"
  },
  {
   "s": 316.1,
   "e": 319.2,
   "ko": "이제 화면을 내려놓고 아이와 직접 놀아보세요.",
   "hi": "내려놓고"
  },
  {
   "s": 319.3,
   "e": 321.2,
   "ko": "길게 하지 않아도 괜찮아요.",
   "hi": "괜찮아요"
  },
  {
   "s": 321.3,
   "e": 323.9,
   "ko": "아이가 즐거워하는 만큼 함께 해주세요.",
   "hi": "즐거워하는"
  },
  {
   "s": 323.95,
   "e": 330.3,
   "ko": "그리고 오늘 나중에 곰 그림이나 인형을 다시 만났을 때 한 번 더 말해보세요.",
   "hi": "다시"
  },
  {
   "s": 332.9,
   "e": 337.5,
   "ko": "워크시트에서 사용한 영어가 우리 생활 속에도 쓰이는 순간이에요.",
   "hi": "생활 속"
  },
  {
   "s": 337.6,
   "e": 339.6,
   "ko": "오늘의 첫 번째 작은 모험.",
   "hi": "작은 모험"
  },
  {
   "s": 339.65,
   "e": 341.9,
   "ko": "그럼 즐겁게 시작해볼까요?",
   "hi": "즐겁게"
  },
  {
   "s": 342.1,
   "e": 346.0,
   "ko": "즐겁게 놀아요! 2일차에 만나요! 안녕!",
   "hi": "2일차"
  }
