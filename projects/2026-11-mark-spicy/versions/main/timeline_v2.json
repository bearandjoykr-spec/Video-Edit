 "captions": [
  {
   "i": 0,
   "s": 0.06999999999999999,
   "e": 3.308,
   "ko": "제가 일했던 유아 영어학원(영유)은",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 1,
   "s": 3.2279999999999998,
   "e": 6.28,
   "ko": "시험, 시험, 또 시험이었어요.",
   "en": "",
   "hi": "또 시험",
   "demo": false,
   "words": []
  },
  {
   "i": 2,
   "s": 6.2,
   "e": 9.13,
   "ko": "Q. 영유의 가장 큰 문제는 뭔가요?",
   "en": "",
   "hi": "가장 큰 문제는",
   "demo": false,
   "words": []
  },
  {
   "i": 3,
   "s": 9.05,
   "e": 11.5,
   "ko": "20년 동안 교사로 일하면서",
   "en": "",
   "hi": "20년",
   "demo": false,
   "words": []
  },
  {
   "i": 4,
   "s": 11.42,
   "e": 13.53,
   "ko": "가장 큰 문제는",
   "en": "",
   "hi": "가장 큰 문제는",
   "demo": false,
   "words": []
  },
  {
   "i": 5,
   "s": 13.45,
   "e": 16.7,
   "ko": "'압박'이라고 생각해요.",
   "en": "",
   "hi": "'압박'",
   "demo": false,
   "words": []
  },
  {
   "i": 6,
   "s": 16.62,
   "e": 19.745,
   "ko": "세계 최고의 대학들은",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 7,
   "s": 19.665000000000003,
   "e": 24.47,
   "ko": "어릴 때부터 시험만 보며 자란 아이를",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 8,
   "s": 24.39,
   "e": 26.62,
   "ko": "원하지 않아요.",
   "en": "",
   "hi": "원하지 않아요.",
   "demo": false,
   "words": []
  },
  {
   "i": 9,
   "s": 26.540000000000003,
   "e": 30.587,
   "ko": "예를 들어, 제가 있던 영유는",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 10,
   "s": 30.507,
   "e": 33.983,
   "ko": "아이에게 B 아래 점수를",
   "en": "",
   "hi": "B 아래",
   "demo": false,
   "words": []
  },
  {
   "i": 11,
   "s": 33.903,
   "e": 36.869,
   "ko": "절대 주지 않았어요.",
   "en": "",
   "hi": "절대",
   "demo": false,
   "words": []
  },
  {
   "i": 12,
   "s": 36.789,
   "e": 39.393,
   "ko": "부모님이 아이를",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 13,
   "s": 39.313,
   "e": 43.56,
   "ko": "다른 곳으로 옮길까 봐서요.",
   "en": "",
   "hi": "옮길까",
   "demo": false,
   "words": []
  },
  {
   "i": 14,
   "s": 43.480000000000004,
   "e": 46.69,
   "ko": "결과가 실제보다 좋게 나오는 거죠.",
   "en": "",
   "hi": "실제보다",
   "demo": false,
   "words": []
  },
  {
   "i": 15,
   "s": 46.61,
   "e": 49.1,
   "ko": "아이를 계속 다니게 하려고요.",
   "en": "",
   "hi": "계속",
   "demo": false,
   "words": []
  },
  {
   "i": 16,
   "s": 49.02,
   "e": 51.4,
   "ko": "결국 이건 비즈니스예요.",
   "en": "",
   "hi": "비즈니스",
   "demo": false,
   "words": []
  },
  {
   "i": 17,
   "s": 51.32,
   "e": 53.144,
   "ko": "그럼 누가 손해일까요?",
   "en": "",
   "hi": "누가 손해",
   "demo": false,
   "words": []
  },
  {
   "i": 18,
   "s": 53.064,
   "e": 56.25,
   "ko": "여러분의 아이, 그리고 여러분이에요.",
   "en": "",
   "hi": "여러분의 아이,",
   "demo": false,
   "words": []
  },
  {
   "i": 19,
   "s": 56.17,
   "e": 57.662,
   "ko": "그래서 저희는",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 20,
   "s": 57.582,
   "e": 60.33,
   "ko": "실수해도 괜찮다고 말해요.",
   "en": "",
   "hi": "실수해도",
   "demo": false,
   "words": []
  },
  {
   "i": 21,
   "s": 60.25,
   "e": 64.97,
   "ko": "다시 말씀드리지만 이건 제 경험이에요.",
   "en": "",
   "hi": "제 경험",
   "demo": false,
   "words": []
  },
  {
   "i": 22,
   "s": 64.89,
   "e": 68.82,
   "ko": "모든 영유가 그렇다는 건 아니에요.",
   "en": "",
   "hi": "모든 영유가",
   "demo": false,
   "words": []
  },
  {
   "i": 23,
   "s": 68.74,
   "e": 71.694,
   "ko": "아이를 잘 보시고",
   "en": "",
   "hi": "",
   "demo": false,
