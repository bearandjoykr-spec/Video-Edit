 "captions": [
  {
   "i": 0,
   "s": 0,
   "e": 2.086,
   "ko": "아이들에게 주는 압박,",
   "en": "",
   "hi": "압박,",
   "demo": false,
   "words": []
  },
  {
   "i": 1,
   "s": 2.006,
   "e": 5.06,
   "ko": "그리고 가정에 주는 압박이요.",
   "en": "",
   "hi": "압박이요.",
   "demo": false,
   "words": []
  },
  {
   "i": 2,
   "s": 4.9799999999999995,
   "e": 7.91,
   "ko": "Q. 유아 영어학원(영유)의 가장 큰 문제는요?",
   "en": "",
   "hi": "가장 큰 문제는",
   "demo": false,
   "words": []
  },
  {
   "i": 3,
   "s": 7.83,
   "e": 10.28,
   "ko": "20년 동안 교사로 일하면서",
   "en": "",
   "hi": "20년",
   "demo": false,
   "words": []
  },
  {
   "i": 4,
   "s": 10.2,
   "e": 12.31,
   "ko": "가장 큰 문제는",
   "en": "",
   "hi": "가장 큰 문제는",
   "demo": false,
   "words": []
  },
  {
   "i": 5,
   "s": 12.23,
   "e": 15.84,
   "ko": "'압박'이라고 생각해요.",
   "en": "",
   "hi": "'압박'",
   "demo": false,
   "words": []
  },
  {
   "i": 6,
   "s": 15.76,
   "e": 18.788,
   "ko": "제가 일했던 영유들은",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 7,
   "s": 18.708000000000002,
   "e": 22.59,
   "ko": "시험, 시험, 또 시험이었어요.",
   "en": "",
   "hi": "또 시험",
   "demo": false,
   "words": []
  },
  {
   "i": 8,
   "s": 22.51,
   "e": 25.681,
   "ko": "예를 들어, 제가 있던 영유는",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 9,
   "s": 25.601000000000003,
   "e": 28.492,
   "ko": "아이에게 B 아래 점수를",
   "en": "",
   "hi": "B 아래",
   "demo": false,
   "words": []
  },
  {
   "i": 10,
   "s": 28.412000000000003,
   "e": 30.74,
   "ko": "절대 주지 않았어요.",
   "en": "",
   "hi": "절대",
   "demo": false,
   "words": []
  },
  {
   "i": 11,
   "s": 30.66,
   "e": 34.162,
   "ko": "부모님이 아이를",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 12,
   "s": 34.082,
   "e": 39.74,
   "ko": "다른 곳으로 옮길까 봐서요.",
   "en": "",
   "hi": "옮길까",
   "demo": false,
   "words": []
  },
  {
   "i": 13,
   "s": 39.660000000000004,
   "e": 42.291,
   "ko": "실제보다 좋은 점수로",
   "en": "",
   "hi": "실제보다",
   "demo": false,
   "words": []
  },
  {
   "i": 14,
   "s": 42.211,
   "e": 45.72,
   "ko": "아이를 계속 다니게 하는 거죠.",
   "en": "",
   "hi": "계속",
   "demo": false,
   "words": []
  },
  {
   "i": 15,
   "s": 45.64,
   "e": 47.87,
   "ko": "결국 이건 비즈니스예요.",
   "en": "",
   "hi": "비즈니스",
   "demo": false,
   "words": []
  },
  {
   "i": 16,
   "s": 47.79,
   "e": 49.614,
   "ko": "그럼 누가 손해일까요?",
   "en": "",
   "hi": "누가 손해",
   "demo": false,
   "words": []
  },
  {
   "i": 17,
   "s": 49.534,
   "e": 52.72,
   "ko": "여러분의 아이, 그리고 여러분이에요.",
   "en": "",
   "hi": "여러분의 아이,",
   "demo": false,
   "words": []
  },
  {
   "i": 18,
   "s": 52.64,
   "e": 54.132,
   "ko": "그래서 저희는",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 19,
   "s": 54.052,
   "e": 56.8,
