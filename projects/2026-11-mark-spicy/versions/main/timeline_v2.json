  },
  {
   "i": 1,
   "s": 2.006,
   "e": 5.06,
   "ko": "그리고 가정에 주는 압박이요.",
   "en": "",
   "hi": "압박이요.",
   "demo": false,
   "words": []
  },
  {
   "i": 2,
   "s": 4.9799999999999995,
   "e": 7.91,
   "ko": "Q. 유아 영어학원(영유)의 가장 큰 문제는요?",
   "en": "",
   "hi": "가장 큰 문제는",
   "demo": false,
   "words": []
  },
  {
   "i": 3,
   "s": 7.83,
   "e": 10.56,
   "ko": "20년 동안 교사로 일하면서",
   "en": "",
   "hi": "20년",
   "demo": false,
   "words": []
  },
  {
   "i": 4,
   "s": 10.48,
   "e": 12.59,
   "ko": "가장 큰 문제는",
   "en": "",
   "hi": "가장 큰 문제는",
   "demo": false,
   "words": []
  },
  {
   "i": 5,
   "s": 12.51,
   "e": 16.12,
   "ko": "'압박'이라고 생각해요.",
   "en": "",
   "hi": "'압박'",
   "demo": false,
   "words": []
  },
  {
   "i": 6,
   "s": 16.040000000000003,
   "e": 19.068,
   "ko": "제가 일했던 영유들은",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 7,
   "s": 18.988000000000003,
   "e": 22.87,
   "ko": "시험, 시험, 또 시험이었어요.",
   "en": "",
   "hi": "또 시험",
   "demo": false,
   "words": []
  },
  {
   "i": 8,
   "s": 22.790000000000003,
   "e": 25.961,
   "ko": "예를 들어, 제가 있던 영유는",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 9,
   "s": 25.881,
   "e": 28.772,
   "ko": "아이에게 B 아래 점수를",
   "en": "",
   "hi": "B 아래",
   "demo": false,
   "words": []
  },
  {
   "i": 10,
   "s": 28.692,
   "e": 31.02,
   "ko": "절대 주지 않았어요.",
   "en": "",
   "hi": "절대",
   "demo": false,
   "words": []
  },
  {
   "i": 11,
   "s": 30.94,
   "e": 34.442,
   "ko": "부모님이 아이를",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 12,
   "s": 34.362,
   "e": 39.77,
   "ko": "다른 곳으로 옮길까 봐서요.",
   "en": "",
   "hi": "옮길까",
   "demo": false,
   "words": []
  },
  {
   "i": 13,
   "s": 39.690000000000005,
   "e": 42.17,
   "ko": "실제보다 좋은 점수로",
   "en": "",
   "hi": "실제보다",
   "demo": false,
   "words": []
  },
  {
   "i": 14,
   "s": 42.09,
   "e": 45.37,
   "ko": "아이를 계속 다니게 하는 거죠.",
   "en": "",
   "hi": "계속",
   "demo": false,
   "words": []
  },
  {
   "i": 15,
   "s": 45.29,
   "e": 47.45,
