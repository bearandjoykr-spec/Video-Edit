 "captions": [
  {
   "i": 0,
   "s": 0,
   "e": 2.086,
   "ko": "아이들에게 주는 압박,",
   "en": "",
   "hi": "압박,",
   "demo": false,
   "words": []
  },
  {
   "i": 1,
   "s": 2.006,
   "e": 5.06,
   "ko": "그리고 가정에 주는 압박이요.",
   "en": "",
   "hi": "압박이요.",
   "demo": false,
   "words": []
  },
  {
   "i": 2,
   "s": 4.9799999999999995,
   "e": 7.91,
   "ko": "Q. 유아 영어학원(영유)의 가장 큰 문제는요?",
   "en": "",
   "hi": "가장 큰 문제는",
   "demo": false,
   "words": []
  },
  {
   "i": 3,
   "s": 7.83,
   "e": 10.56,
   "ko": "20년 동안 교사로 일하면서",
   "en": "",
   "hi": "20년",
   "demo": false,
   "words": []
  },
  {
   "i": 4,
   "s": 10.48,
   "e": 12.59,
   "ko": "가장 큰 문제는",
   "en": "",
   "hi": "가장 큰 문제는",
   "demo": false,
   "words": []
  },
  {
   "i": 5,
   "s": 12.51,
   "e": 15.12,
   "ko": "'압박'이라고 생각해요.",
   "en": "",
   "hi": "'압박'",
   "demo": false,
   "words": []
  },
  {
   "i": 6,
   "s": 15.04,
   "e": 17.788,
   "ko": "제가 일했던 영유들은",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 7,
   "s": 17.708000000000002,
   "e": 21.48,
   "ko": "시험, 시험, 또 시험이었어요.",
   "en": "",
   "hi": "또 시험",
   "demo": false,
   "words": []
  },
  {
   "i": 8,
   "s": 21.400000000000002,
   "e": 23.921,
   "ko": "예를 들어, 제가 있던 영유는",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 9,
   "s": 23.841,
   "e": 26.732,
   "ko": "아이에게 B 아래 점수를",
   "en": "",
   "hi": "B 아래",
   "demo": false,
   "words": []
  },
  {
   "i": 10,
   "s": 26.652,
   "e": 28.98,
   "ko": "절대 주지 않았어요.",
   "en": "",
   "hi": "절대",
   "demo": false,
   "words": []
  },
  {
   "i": 11,
   "s": 28.900000000000002,
   "e": 32.402,
   "ko": "부모님이 아이를",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 12,
   "s": 32.322,
   "e": 37.73,
   "ko": "다른 곳으로 옮길까 봐서요.",
   "en": "",
   "hi": "옮길까",
   "demo": false,
   "words": []
  },
  {
   "i": 13,
   "s": 37.65,
   "e": 40.13,
   "ko": "실제보다 좋은 점수로",
   "en": "",
   "hi": "실제보다",
   "demo": false,
   "words": []
  },
  {
   "i": 14,
   "s": 40.050000000000004,
   "e": 43.33,
   "ko": "아이를 계속 다니게 하는 거죠.",
   "en": "",
   "hi": "계속",
   "demo": false,
   "words": []
  },
  {
   "i": 15,
   "s": 43.25,
   "e": 45.41,
   "ko": "결국 이건 비즈니스예요.",
   "en": "",
   "hi": "비즈니스",
   "demo": false,
   "words": []
  },
  {
   "i": 16,
   "s": 45.33,
   "e": 46.891,
   "ko": "그럼 누가 손해일까요?",
   "en": "",
   "hi": "누가 손해",
   "demo": false,
   "words": []
  },
  {
   "i": 17,
   "s": 46.811,
   "e": 49.56,
   "ko": "여러분의 아이, 그리고 여러분이에요.",
   "en": "",
   "hi": "여러분의 아이,",
   "demo": false,
   "words": []
  },
  {
   "i": 18,
   "s": 49.480000000000004,
   "e": 50.972,
   "ko": "그래서 저희는",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 19,
   "s": 50.892,
   "e": 53.61,
   "ko": "실수해도 괜찮다고 말해요.",
   "en": "",
   "hi": "실수해도",
   "demo": false,
   "words": []
  },
  {
   "i": 20,
   "s": 53.53,
   "e": 57.375,
   "ko": "말씀드리지만 이건 제 경험이에요.",
   "en": "",
   "hi": "제 경험",
   "demo": false,
   "words": []
  },
  {
   "i": 21,
   "s": 57.295,
   "e": 60.62,
   "ko": "모든 영유가 그렇다는 건 아니에요.",
   "en": "",
   "hi": "모든 영유가",
