 "captions": [
  {
   "i": 0,
   "s": 0,
   "e": 2.58,
   "ko": "유치원이 원생을 놓치지 않으려고",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 1,
   "s": 2.5,
   "e": 5.211,
   "ko": "시험 결과를 조작하기도 한다는 걸",
   "en": "",
   "hi": "조작하기도",
   "demo": false,
   "words": []
  },
  {
   "i": 2,
   "s": 5.131,
   "e": 6.13,
   "ko": "아셔야 해요.",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 3,
   "s": 6.05,
   "e": 8.98,
   "ko": "Q. 영유의 가장 큰 문제는 뭔가요?",
   "en": "",
   "hi": "가장 큰 문제는",
   "demo": false,
   "words": []
  },
  {
   "i": 4,
   "s": 8.9,
   "e": 11.35,
   "ko": "20년 동안 교사로 일하면서",
   "en": "",
   "hi": "20년",
   "demo": false,
   "words": []
  },
  {
   "i": 5,
   "s": 11.27,
   "e": 13.38,
   "ko": "가장 큰 문제는",
   "en": "",
   "hi": "가장 큰 문제는",
   "demo": false,
   "words": []
  },
  {
   "i": 6,
   "s": 13.3,
   "e": 16.62,
   "ko": "'압박'이라고 생각해요.",
   "en": "",
   "hi": "'압박'",
   "demo": false,
   "words": []
  },
  {
   "i": 7,
   "s": 16.540000000000003,
   "e": 19.41,
   "ko": "제가 일했던 유치원들은",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 8,
   "s": 19.330000000000002,
   "e": 22.83,
   "ko": "시험, 시험, 또 시험이었어요.",
   "en": "",
   "hi": "또 시험",
   "demo": false,
   "words": []
  },
  {
   "i": 9,
   "s": 22.75,
   "e": 25.875,
   "ko": "세계 최고의 대학들은",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 10,
   "s": 25.795,
   "e": 30.6,
   "ko": "어릴 때부터 시험만 보며 자란 아이를",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 11,
   "s": 30.520000000000003,
   "e": 32.75,
   "ko": "원하지 않아요.",
   "en": "",
   "hi": "원하지 않아요.",
   "demo": false,
   "words": []
  },
  {
   "i": 12,
   "s": 32.67,
   "e": 36.93,
   "ko": "예를 들어, 제가 있던 유치원은",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 13,
   "s": 36.85,
   "e": 40.309,
   "ko": "아이에게 B 아래 점수를",
   "en": "",
   "hi": "B 아래",
   "demo": false,
   "words": []
  },
  {
   "i": 14,
   "s": 40.229,
   "e": 43.134,
   "ko": "절대 주지 않았어요.",
   "en": "",
   "hi": "절대",
   "demo": false,
   "words": []
  },
  {
   "i": 15,
   "s": 43.054,
   "e": 45.606,
   "ko": "부모님이 아이를",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 16,
   "s": 45.526,
   "e": 49.69,
   "ko": "다른 곳으로 옮길까 봐서요.",
   "en": "",
   "hi": "옮길까",
   "demo": false,
   "words": []
  },
  {
   "i": 17,
   "s": 49.61,
   "e": 51.984,
   "ko": "결과를 꾸며서라도",
   "en": "",
   "hi": "꾸며서라도",
   "demo": false,
   "words": []
  },
  {
   "i": 18,
   "s": 51.904,
   "e": 54.587,
   "ko": "아이를 붙잡아 두는 거죠.",
   "en": "",
   "hi": "붙잡아",
   "demo": false,
