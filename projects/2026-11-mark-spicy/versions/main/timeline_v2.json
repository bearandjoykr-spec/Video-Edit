 "captions": [
  {
   "i": 0,
   "s": 0,
   "e": 2.469,
   "ko": "영유가 원생을 놓치지 않으려고",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 1,
   "s": 2.389,
   "e": 5.181,
   "ko": "시험 결과를 조작하기도 한다는 걸",
   "en": "",
   "hi": "조작하기도",
   "demo": false,
   "words": []
  },
  {
   "i": 2,
   "s": 5.101,
   "e": 6.13,
   "ko": "아셔야 해요.",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 3,
   "s": 6.05,
   "e": 8.98,
   "ko": "Q. 유아 영어학원(영유)의 가장 큰 문제는요?",
   "en": "",
   "hi": "가장 큰 문제는",
   "demo": false,
   "words": []
  },
  {
   "i": 4,
   "s": 8.9,
   "e": 11.35,
   "ko": "20년 동안 교사로 일하면서",
   "en": "",
   "hi": "20년",
   "demo": false,
   "words": []
  },
  {
   "i": 5,
   "s": 11.27,
   "e": 13.38,
   "ko": "가장 큰 문제는",
   "en": "",
   "hi": "가장 큰 문제는",
   "demo": false,
   "words": []
  },
  {
   "i": 6,
   "s": 13.3,
   "e": 16.62,
   "ko": "'압박'이라고 생각해요.",
   "en": "",
   "hi": "'압박'",
   "demo": false,
   "words": []
  },
  {
   "i": 7,
   "s": 16.540000000000003,
   "e": 19.41,
   "ko": "제가 일했던 영유들은",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 8,
   "s": 19.330000000000002,
   "e": 22.86,
   "ko": "시험, 시험, 또 시험이었어요.",
   "en": "",
   "hi": "또 시험",
   "demo": false,
   "words": []
  },
  {
   "i": 9,
   "s": 22.78,
   "e": 25.951,
   "ko": "예를 들어, 제가 있던 영유는",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 10,
   "s": 25.871000000000002,
   "e": 28.552,
   "ko": "아이에게 B 아래 점수를",
   "en": "",
   "hi": "B 아래",
   "demo": false,
   "words": []
  },
  {
   "i": 11,
   "s": 28.472,
   "e": 30.8,
   "ko": "절대 주지 않았어요.",
   "en": "",
   "hi": "절대",
   "demo": false,
   "words": []
  },
  {
   "i": 12,
   "s": 30.720000000000002,
   "e": 34.222,
   "ko": "부모님이 아이를",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 13,
   "s": 34.142,
   "e": 39.8,
   "ko": "다른 곳으로 옮길까 봐서요.",
   "en": "",
   "hi": "옮길까",
   "demo": false,
   "words": []
  },
  {
   "i": 14,
   "s": 39.72,
   "e": 42.18,
   "ko": "결과를 꾸며서라도",
   "en": "",
   "hi": "꾸며서라도",
   "demo": false,
   "words": []
  },
  {
   "i": 15,
   "s": 42.1,
   "e": 45.49,
   "ko": "아이를 계속 다니게 하는 거죠.",
   "en": "",
   "hi": "계속",
   "demo": false,
   "words": []
  },
  {
   "i": 16,
   "s": 45.410000000000004,
   "e": 47.64,
   "ko": "결국 이건 비즈니스예요.",
   "en": "",
   "hi": "비즈니스",
   "demo": false,
   "words": []
  },
  {
   "i": 17,
   "s": 47.56,
   "e": 49.384,
   "ko": "그럼 누가 손해일까요?",
   "en": "",
   "hi": "누가 손해",
   "demo": false,
   "words": []
  },
  {
   "i": 18,
   "s": 49.304,
   "e": 52.49,
   "ko": "여러분의 아이, 그리고 여러분이에요.",
   "en": "",
   "hi": "여러분의 아이,",
   "demo": false,
   "words": []
  },
  {
   "i": 19,
   "s": 52.410000000000004,
   "e": 53.902,
   "ko": "그래서 저희는",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 20,
   "s": 53.822,
   "e": 56.57,
   "ko": "실수해도 괜찮다고 말해요.",
   "en": "",
   "hi": "실수해도",
   "demo": false,
   "words": []
  },
  {
   "i": 21,
   "s": 56.49,
   "e": 61.21,
   "ko": "다시 말씀드리지만 이건 제 경험이에요.",
   "en": "",
   "hi": "제 경험",
   "demo": false,
   "words": []
  },
  {
   "i": 22,
   "s": 61.13,
   "e": 65.06,
   "ko": "모든 영유가 그렇다는 건 아니에요.",
   "en": "",
   "hi": "모든 영유가",
   "demo": false,
   "words": []
  },
  {
   "i": 23,
   "s": 64.98,
   "e": 69.43,
   "ko": "아이를 잘 보시고",
   "en": "",
   "hi": "아이를 잘",
   "demo": false,
   "words": []
  },
  {
   "i": 24,
   "s": 69.35000000000001,
   "e": 72.32,
   "ko": "솔직하게 결정하세요.",
   "en": "",
   "hi": "솔직하게",
   "demo": false,
   "words": []
  },
  {
   "i": 25,
   "s": 72.24,
   "e": 75.01,
   "ko": "재미있게, 행복하게요.",
   "en": "",
   "hi": "행복하게요.",
   "demo": false,
   "words": []
  }
 ],
