 "captions": [
  {
   "s": 8.494,
   "e": 11.139,
   "en": "Because that's how we say it in Britain.",
   "ko": "영국에서는 그렇게 말하거든요."
  },
  {
   "s": 11.139,
   "e": 16.854,
   "en": "Five Harry Potter phrases to teach your child before Christmas Day.",
   "ko": "크리스마스 전에 아이에게 알려 줄 해리 포터 표현 5가지!"
  },
  {
   "s": 16.854,
   "e": 19.727,
   "en": "Number five, Happy Christmas.",
   "ko": "5번, 해피 크리스마스."
  },
  {
   "s": 19.727,
   "e": 22.479,
   "en": "Same meaning, more British.",
   "ko": "뜻은 같아요, 더 영국식일 뿐!"
  },
  {
   "s": 23.969,
   "e": 25.889,
   "en": "Four, Brilliant.",
   "ko": "4번, 브릴리언트."
  },
  {
   "s": 25.889,
   "e": 28.272,
   "en": "Not “good job” — brilliant.",
   "ko": "“잘했어” 말고, “최고야!”"
  },
  {
   "s": 30.212,
   "e": 32.221,
   "en": "Number three, Blimey.",
   "ko": "3번, 블라이미."
  },
  {
   "s": 32.221,
   "e": 36.099,
   "en": "For when the snow is this deep… Blimey.",
   "ko": "눈이 이만큼 쌓였을 때, “세상에!”"
  },
  {
   "s": 37.439,
   "e": 39.477,
   "en": "Two, Off you go.",
   "ko": "2번, 오프 유 고."
  },
  {
   "s": 39.477,
   "e": 42.577,
   "en": "Shoes on, coat on, off you go.",
   "ko": "신발 신고, 코트 입고, “자, 출발!”"
  },
  {
   "s": 46.217,
   "e": 50.994,
   "en": "And number one, for when the toys are finally tidied away…",
   "ko": "그리고 1번, 장난감을 다 정리했을 때…"
  },
  {
   "s": 50.994,
   "e": 53.993,
   "en": "(whisper) Mischief managed.",
   "ko": "(속삭이며) “장난 완료.”"
  },
  {
   "s": 56.133,
   "e": 61.153,
   "en": "Save this and try one tonight. Happy Christmas from Oxford.",
   "ko": "저장해 두고 오늘 밤 하나 써 보세요. 옥스퍼드에서, 해피 크리스마스!"
  }
 ],
