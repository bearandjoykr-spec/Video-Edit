 "captions": [
  {
   "i": 0,
   "s": 0.15,
   "e": 2.887,
   "ko": "영어 그림책, 뭐부터 살지 고민이라면?",
   "en": "",
   "hi": "고민이라면?",
   "demo": false,
   "words": []
  },
  {
   "i": 1,
   "s": 2.887,
   "e": 4.1,
   "ko": "이 세 권부터!",
   "en": "",
   "hi": "세 권",
   "demo": false,
   "words": []
  },
  {
   "i": 2,
   "s": 4.1,
   "e": 5.921,
   "ko": "조이예요! 오늘은 서점에서",
   "en": "",
   "hi": "서점에서",
   "demo": false,
   "words": []
  },
  {
   "i": 3,
   "s": 5.921,
   "e": 9.2,
   "ko": "아이랑 읽기 좋은 영어 그림책을 골라봤어요.",
   "en": "",
   "hi": "영어 그림책",
   "demo": false,
   "words": []
  },
  {
   "i": 4,
   "s": 9.2,
   "e": 10.359,
   "ko": "기준은 딱 하나,",
   "en": "",
   "hi": "딱 하나",
   "demo": false,
   "words": []
  },
  {
   "i": 5,
   "s": 10.359,
   "e": 12.29,
   "ko": "아이가 '한 번 더!'를",
   "en": "",
   "hi": "한 번 더!",
   "demo": false,
   "words": []
  },
  {
   "i": 6,
   "s": 12.29,
   "e": 13.641,
   "ko": "외치는 책이에요.",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 7,
   "s": 13.641,
   "e": 15.1,
   "ko": "자, 바로 볼게요!",
   "en": "",
   "hi": "바로",
   "demo": false,
   "words": []
  },
  {
   "i": 8,
   "s": 15.1,
   "e": 16.915,
   "ko": "첫 번째, I Want My Hat Back.",
   "en": "",
   "hi": "I Want My Hat Back.",
   "demo": false,
   "words": []
  },
  {
   "i": 9,
   "s": 16.915,
   "e": 18.988,
   "ko": "모자 잃은 곰이 계속 물어봐요.",
   "en": "",
   "hi": "계속",
   "demo": false,
   "words": []
  },
  {
   "i": 10,
   "s": 18.988,
   "e": 20.544,
   "ko": "'Have you seen my hat?'",
   "en": "",
   "hi": "Have you seen my hat?",
   "demo": false,
   "words": []
  },
  {
   "i": 11,
   "s": 20.544,
   "e": 22.272,
   "ko": "반복이라 금방 따라 하고,",
   "en": "",
   "hi": "따라 하고",
   "demo": false,
   "words": []
  },
  {
   "i": 12,
   "s": 22.272,
   "e": 24.3,
   "ko": "마지막 반전에 빵 터져요!",
   "en": "",
   "hi": "빵 터져요!",
   "demo": false,
   "words": []
  },
  {
   "i": 13,
   "s": 24.3,
   "e": 26.475,
   "ko": "두 번째, The Very Hungry Caterpillar.",
   "en": "",
   "hi": "The Very Hungry Caterpillar.",
   "demo": false,
   "words": []
  },
  {
   "i": 14,
   "s": 26.475,
   "e": 29.133,
   "ko": "요일, 숫자, 과일까지 한 권에!",
   "en": "",
   "hi": "한 권에!",
   "demo": false,
   "words": []
  },
  {
   "i": 15,
   "s": 29.133,
   "e": 31.792,
   "ko": "책 구멍에 손가락 쏙 넣으며",
   "en": "",
   "hi": "손가락 쏙",
   "demo": false,
   "words": []
  },
  {
   "i": 16,
   "s": 31.792,
   "e": 33.2,
   "ko": "읽어 주세요.",
   "en": "",
   "hi": "읽어",
   "demo": false,
   "words": []
  },
  {
   "i": 17,
   "s": 33.2,
   "e": 34.853,
   "ko": "세 번째, My Mum과 My Dad.",
   "en": "",
   "hi": "My Dad.",
   "demo": false,
   "words": []
  },
  {
   "i": 18,
   "s": 34.853,
   "e": 36.837,
   "ko": "'She's…', 'He's…' 짧은 문장으로",
   "en": "",
   "hi": "짧은 문장",
   "demo": false,
   "words": []
  },
  {
   "i": 19,
   "s": 36.837,
   "e": 38.324,
   "ko": "엄마 아빠를 자랑해요.",
   "en": "",
   "hi": "자랑해요.",
   "demo": false,
   "words": []
  },
  {
   "i": 20,
   "s": 38.324,
   "e": 40.308,
   "ko": "읽고 나서 우리 가족 이야기로",
   "en": "",
   "hi": "가족 이야기로",
   "demo": false,
   "words": []
  },
  {
   "i": 21,
   "s": 40.308,
   "e": 41.5,
   "ko": "이어가 보세요!",
   "en": "",
   "hi": "이어가",
   "demo": false,
   "words": []
  },
  {
   "i": 22,
   "s": 41.5,
   "e": 43.796,
   "ko": "저장해 두고 서점 갈 때 꺼내 보세요!",
   "en": "",
   "hi": "저장해 두고",
