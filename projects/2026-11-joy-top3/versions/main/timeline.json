  },
  {
   "s": 27.7,
   "e": 30.02,
   "ko": "대망의 1위! I Want My Hat Back.",
   "hi": "1위!"
  },
  {
   "s": 30.02,
   "e": 32.247,
   "ko": "모자 잃은 곰이 계속 물어봐요.",
   "hi": "물어봐"
  },
  {
   "s": 32.247,
   "e": 33.917,
   "ko": "'Have you seen my hat?'",
   "hi": "Have you seen my hat?"
