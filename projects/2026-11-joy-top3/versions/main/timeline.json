   "hi": "Caterpillar."
  },
  {
   "s": 18.968,
   "e": 21.014,
   "ko": "요일, 숫자, 음식 이름이",
   "hi": "요일, 숫자, 음식"
  },
  {
   "s": 21.014,
   "e": 23.059,
   "ko": "한 권에 다 들어 있어요.",
   "hi": "한 권에"
  },
  {
   "s": 23.059,
