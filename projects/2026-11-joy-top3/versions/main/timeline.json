   "e": 7.45,
   "ko": "그럼, 3위부터 갈게요!",
   "hi": "3위부터"
  },
  {
   "s": 7.45,
   "e": 9.8,
   "ko": "3위! 앤서니 브라운의 My Mum, My Dad.",
   "hi": "My Mum, My Dad."
  },
  {
   "s": 9.8,
   "e": 11.68,
   "ko": "'She's…', 'He's…' 짧은 문장으로",
   "hi": "짧은 문장"
  },
  {
   "s": 11.68,
   "e": 13.717,
   "ko": "엄마 아빠를 자랑하는 책이에요.",
   "hi": "자랑하는"
  },
  {
