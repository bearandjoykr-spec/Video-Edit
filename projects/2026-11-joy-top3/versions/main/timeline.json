  {
   "s": 16.16,
   "e": 17.4,
   "ko": "물어봐 주세요.",
   "hi": "물어봐"
  },
  {
   "s": 17.4,
   "e": 19.218,
   "ko": "2위! The Very Hungry Caterpillar.",
   "hi": "Caterpillar."
  },
  {
   "s": 19.218,
   "e": 21.264,
   "ko": "요일, 숫자, 음식 이름이",
   "hi": "요일, 숫자, 음식"
  },
  {
   "s": 21.264,
   "e": 23.309,
   "ko": "한 권에 다 들어 있어요.",
   "hi": "한 권에"
  },
  {
   "s": 23.309,
   "e": 26.264,
   "ko": "책 구멍에 손가락을 쏙 넣으면서",
