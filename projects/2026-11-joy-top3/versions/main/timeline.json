  },
  {
   "s": 6.233,
   "e": 7.7,
   "ko": "3위부터 갈게요!",
   "hi": "3위부터"
  },
  {
   "s": 7.7,
   "e": 10.05,
   "ko": "3위! 앤서니 브라운의 My Mum, My Dad.",
   "hi": "My Mum, My Dad."
  },
  {
   "s": 10.05,
   "e": 11.93,
   "ko": "'She's…', 'He's…' 짧은 문장으로",
   "hi": "짧은 문장"
  },
  {
