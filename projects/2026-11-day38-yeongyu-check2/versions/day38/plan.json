 "captions": [
  {
   "s": 0.0,
   "e": 3.735,
   "text": "우리 아이가 다니는 영유에서\n선생님이 자주 바뀐다면?",
   "sec": "hook"
  },
  {
   "s": 3.755,
   "e": 6.599,
   "text": "첫 번째, 교사의 근속 기간",
   "sec": "p1"
  },
  {
   "s": 6.619,
   "e": 9.763,
   "text": "아이들에게 선생님은 단순히\n영어를 가르치는 사람이 아니라",
   "sec": "p1"
  },
  {
   "s": 9.783,
   "e": 12.781,
   "text": "매일 만나고 관계를\n쌓아가는 사람이에요",
   "sec": "p1"
  },
  {
   "s": 12.801,
   "e": 16.144,
   "text": "그런데 선생님이 자주 바뀐다면\n아이들은 새로운 선생님에게",
   "sec": "p1"
  },
  {
   "s": 16.164,
   "e": 18.79,
   "text": "적응하는 과정을\n반복해야 할 수도 있어요",
   "sec": "p1"
  },
  {
   "s": 18.81,
   "e": 23.69,
   "text": "상담하실 때 선생님들이 평균적으로\n얼마나 오래 근무하시는지",
   "sec": "p1"
  },
  {
   "s": 23.71,
   "e": 28.154,
   "text": "교사가 바뀐다면 아이들의 특성과\n수업 내용은 어떻게 인수인계되는지",
   "sec": "p1"
  },
  {
   "s": 28.174,
   "e": 29.054,
   "text": "꼭 물어보세요",
   "sec": "p1"
  },
  {
   "s": 29.074,
   "e": 30.864,
   "text": "그럼 내일 만나요, 안녕! 👋",
   "sec": "bye"
  }
 ],
