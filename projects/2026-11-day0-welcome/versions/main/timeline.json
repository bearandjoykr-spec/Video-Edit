 "captions": [
  {
   "s": 7.67,
   "e": 9.3,
   "ko": "안녕하세요, 저는 조이입니다.",
   "hi": "조이"
  },
  {
   "s": 9.3,
   "e": 10.77,
   "ko": "그리고 저는 마크예요.",
   "hi": "마크"
  },
  {
   "s": 10.77,
   "e": 14.99,
   "ko": "Bear & Joy의 Little Steps에 오신 것을 환영합니다.",
   "hi": "Little Steps"
  },
  {
   "s": 15.04,
   "e": 16.24,
   "ko": "앞으로 7일 동안,",
   "hi": "7일"
  },
  {
   "s": 16.24,
   "e": 18.84,
   "ko": "아이와 함께하는 일상의 작은 순간에",
   "hi": "작은 순간"
  },
  {
   "s": 18.84,
   "e": 20.34,
   "ko": "영어를 더해 볼 거예요.",
   "hi": "영어를 더해"
  },
  {
   "s": 20.34,
   "e": 23.5,
   "ko": "첫 번째  little step은 걱정부터 내려놓는 거예요.",
   "hi": "걱정"
  },
  {
   "s": 23.5,
   "e": 26.04,
   "ko": "그래서 저희가 함께하는 거예요.",
   "hi": "함께"
  },
  {
   "s": 26.04,
   "e": 27.14,
   "ko": "시작하기 전에",
   "hi": ""
  },
  {
   "s": 27.14,
   "e": 29.32,
   "ko": "이런 생각이 드실 수도 있어요.",
   "hi": ""
  },
  {
   "s": 29.47,
   "e": 33.37,
   "ko": "“우리 아이는 아직 아기인데, 너무 이른 건 아닐까요?”",
   "hi": "너무 이른"
  },
  {
   "s": 33.37,
   "e": 36.3,
   "ko": "또는 “우리 아이는 이미 영어를 잘하는데,",
   "hi": "이미"
  },
  {
   "s": 36.3,
   "e": 38.14,
   "ko": "너무 쉬운 건 아닐까요?”",
   "hi": "너무 쉬운"
  },
  {
   "s": 38.14,
   "e": 39.94,
   "ko": "그 질문에 답하기 전에,",
   "hi": "질문"
  },
  {
   "s": 39.94,
   "e": 42.94,
   "ko": "저희가 가장 중요하게 생각하는 이야기를",
   "hi": "가장 중요하게"
  },
  {
   "s": 42.94,
   "e": 44.95,
   "ko": "먼저 들려드릴게요.",
   "hi": ""
  },
  {
   "s": 45.84,
   "e": 48.97,
   "ko": "가르치려고 하지 말고, 사용하세요.",
   "hi": "사용하세요"
  },
  {
   "s": 48.97,
   "e": 50.6,
   "ko": "영어를 가르치려고 하기보다,",
   "hi": ""
  },
  {
   "s": 50.6,
   "e": 52.2,
   "ko": "함께 사용해 보세요.",
   "hi": "함께"
  },
  {
   "s": 52.2,
   "e": 55.4,
   "ko": "함께하는 순간 속에서 사용하면,",
   "hi": "함께"
  },
  {
   "s": 55.4,
   "e": 58.9,
   "ko": "짧은 영어 표현에도 의미가 생겨요.",
   "hi": "의미"
  },
  {
   "s": 58.9,
   "e": 61.24,
   "ko": "“Hello”는 반가운 인사가 되고,",
   "hi": "“Hello”"
  },
  {
   "s": 61.24,
   "e": 65.29,
   "ko": "“Look!“은 무언가를 함께 발견하는 말이 되고,",
   "hi": "함께"
  },
  {
   "s": 65.3,
   "e": 69.57,
   "ko": "“Your turn”은 함께하자는 초대가 되죠.",
   "hi": "함께"
  },
  {
   "s": 69.57,
   "e": 73.89,
   "ko": "바로 여기에서 부모님의 역할이 정말 중요해져요.",
   "hi": "부모님의 역할"
  },
  {
   "s": 74.17,
   "e": 76.94,
   "ko": "저희는 영어 표현과 발음,",
   "hi": "표현과 발음"
  },
  {
   "s": 76.94,
   "e": 80.44,
   "ko": "그리고 놀이 아이디어를 드릴 수 있어요.",
   "hi": "놀이 아이디어"
  },
  {
   "s": 80.44,
   "e": 82.8,
   "ko": "그리고 부모님은 아이에게",
   "hi": ""
  },
  {
   "s": 82.8,
   "e": 87.27,
   "ko": "익숙한 목소리와 따뜻한 관심을 건네실 수 있죠.",
   "hi": "따뜻한 관심"
  },
  {
   "s": 87.27,
   "e": 91.64,
   "ko": "무엇이 우리 아이를 웃게 하는지도 알고 계시고요.",
   "hi": "웃게"
  },
  {
   "s": 91.64,
   "e": 94.34,
   "ko": "그런 순간을 통해 아이가",
   "hi": ""
  },
  {
   "s": 94.34,
   "e": 98.34,
   "ko": "“영어는 재밌네? 한번 말해 봐도 괜찮겠다”라고",
   "hi": "재밌네"
  },
  {
   "s": 98.34,
   "e": 101.05,
   "ko": "느끼도록 도와주실 수 있어요.",
   "hi": ""
  },
  {
   "s": 101.14,
   "e": 103.44,
   "ko": "아이가 이렇게 생각할 수 있는 순간이죠.",
   "hi": ""
  },
  {
   "s": 103.44,
   "e": 105.04,
   "ko": "“나도 한번 해 볼 수 있겠어.”",
   "hi": "한번 해 볼 수"
  },
  {
   "s": 105.04,
   "e": 108.62,
   "ko": "“모든 걸 다 맞힐 필요는 없구나.”",
   "hi": "다 맞힐"
  },
  {
   "s": 108.97,
   "e": 111.8,
   "ko": "그래서 저희는 아이의 자신감을 키워주는",
   "hi": "자신감"
  },
  {
   "s": 111.8,
   "e": 116.64,
   "ko": "중요한 열쇠를 부모님이 쥐고 계신다고 믿어요.",
   "hi": "열쇠"
  },
  {
   "s": 116.64,
   "e": 117.97,
   "ko": "영어를 말할 때도,",
   "hi": ""
  },
  {
   "s": 117.97,
   "e": 121.07,
   "ko": "새로운 것을 배울 때도요.",
   "hi": ""
  },
  {
   "s": 121.07,
   "e": 122.54,
   "ko": "그리고 그 시작에",
   "hi": ""
  },
  {
   "s": 122.54,
   "e": 127.04,
   "ko": "부모님의 유창한 영어가 꼭 필요한 건 아니에요.",
   "hi": "유창한"
  },
  {
   "s": 127.04,
   "e": 132.4,
   "ko": "아기에게 우리말로 이야기할 때를 생각해 볼까요?",
   "hi": "우리말"
  },
  {
   "s": 132.4,
   "e": 133.87,
   "ko": "“잘 잤어?”",
   "hi": "잘 잤어"
  },
  {
   "s": 133.87,
   "e": 135.5,
   "ko": "“배고파?”",
   "hi": "배고파"
  },
  {
   "s": 135.5,
   "e": 138.1,
   "ko": "“우리 아기 양말 어디 갔지?”",
   "hi": "양말"
  },
  {
   "s": 138.1,
   "e": 141.14,
   "ko": "아기가 대답할 수 있을 때까지 기다렸다가",
   "hi": "대답할"
  },
  {
   "s": 141.14,
   "e": 143.74,
   "ko": "말을 걸지는 않잖아요.",
   "hi": ""
  },
  {
   "s": 143.74,
   "e": 145.7,
   "ko": "그냥 함께 하루를 보내며",
   "hi": "함께"
  },
  {
   "s": 145.7,
   "e": 147.8,
   "ko": "자연스럽게 이야기하죠.",
   "hi": "자연스럽게"
  },
  {
   "s": 147.8,
   "e": 149.47,
   "ko": "그런 순간에 영어도",
   "hi": ""
  },
  {
   "s": 149.47,
   "e": 151.94,
   "ko": "조금씩 함께할 수 있어요.",
   "hi": "함께"
  },
  {
   "s": 151.94,
   "e": 155.25,
   "ko": "안녕, 우리 아가.",
   "hi": "우리 아가"
  },
  {
   "s": 156.07,
   "e": 158.69,
   "ko": "봐! 곰이다.",
   "hi": "곰이다"
  },
  {
   "s": 159.9,
   "e": 163.64,
   "ko": "아이가 이미 이 표현들을 알고 있다면요?",
   "hi": "이미"
  },
  {
   "s": 163.64,
   "e": 166.5,
   "ko": "그 표현들을 활용해 더 많은 걸 해 볼 수 있도록 해주세요.",
   "hi": "더 많은 걸"
  },
  {
   "s": 166.5,
   "e": 169.37,
   "ko": "이미 영어에 익숙한 아이라면,",
   "hi": "이미"
  },
  {
   "s": 169.37,
   "e": 170.67,
   "ko": "알고 있는 표현으로",
   "hi": ""
  },
  {
   "s": 170.67,
   "e": 172.7,
   "ko": "새로운 놀이를 해 보세요.",
   "hi": "새로운 놀이"
  },
  {
   "s": 172.7,
   "e": 176.27,
   "ko": "곰의 목소리를 만들어도 좋고,",
   "hi": "곰의 목소리"
  },
  {
   "s": 176.27,
   "e": 179.02,
   "ko": "이야기를 지어도 좋고,",
   "hi": "이야기를"
  },
  {
   "s": 179.04,
   "e": 183.15,
   "ko": "부모님께 게임 방법을 설명해 줘도 좋아요.",
   "hi": "게임"
  },
  {
   "s": 183.17,
   "e": 185.77,
   "ko": "안녕. 난 곰이야.",
   "hi": "난 곰이야"
  },
  {
   "s": 185.77,
   "e": 188.14,
   "ko": "내 아침밥은 어디 있지?",
   "hi": "아침밥"
  },
  {
   "s": 188.14,
   "e": 190.74,
   "ko": "아무래도 우리 곰이 배가 고픈가 봐요.",
   "hi": "배가 고픈"
  },
  {
   "s": 190.74,
   "e": 192.77,
   "ko": "이런 짧은 표현 하나로도",
   "hi": "짧은 표현"
  },
  {
   "s": 192.77,
   "e": 195.24,
   "ko": "이야기는 얼마든지 이어질 수 있어요.",
   "hi": ""
  },
  {
   "s": 195.24,
   "e": 200.35,
   "ko": "아이의 생각을 따라가 보세요.",
   "hi": "아이의 생각"
  },
  {
   "s": 200.9,
   "e": 203.67,
   "ko": "매일 제가 유용한 표현 몇 가지를",
   "hi": "매일"
  },
  {
   "s": 203.67,
   "e": 205.94,
   "ko": "알려드릴 거예요.",
   "hi": ""
  },
  {
   "s": 205.94,
   "e": 209.8,
   "ko": "먼저 천천히, 그다음 자연스러운 속도로",
   "hi": "천천히"
  },
  {
   "s": 209.8,
   "e": 211.89,
   "ko": "연습할 시간도 드릴게요.",
   "hi": "연습할"
  },
  {
   "s": 212.17,
   "e": 216.17,
   "ko": "그리고 저는 워크시트를 소개하고,",
   "hi": "워크시트"
  },
  {
   "s": 216.17,
   "e": 220.4,
   "ko": "아이와 어떻게 놀고 이야기하면 좋을지 알려드릴게요.",
   "hi": ""
  },
  {
   "s": 220.4,
   "e": 222.3,
   "ko": "워크시트는",
   "hi": "워크시트"
  },
  {
   "s": 222.3,
   "e": 224.1,
   "ko": "놀이를 시작하는 작은 도구예요.",
   "hi": "도구"
  },
  {
   "s": 224.1,
   "e": 226.92,
   "ko": "끝까지 완성해야 하는 건 아니에요.",
   "hi": "완성"
  },
  {
   "s": 227.44,
   "e": 229.4,
   "ko": "활동 방법을 확인하셨다면,",
   "hi": "활동 방법"
  },
  {
   "s": 229.4,
   "e": 231.8,
   "ko": "이제 화면은 잠시 내려놓고",
   "hi": "화면"
  },
  {
   "s": 231.8,
   "e": 234.44,
   "ko": "아이와 함께해 주세요.",
   "hi": "함께"
  },
  {
   "s": 234.44,
   "e": 235.84,
   "ko": "표현 하나를 써 보세요.",
   "hi": "표현 하나"
  },
  {
   "s": 235.84,
   "e": 238.27,
   "ko": "잠깐 기다려 보세요.",
   "hi": "잠깐"
  },
  {
   "s": 238.27,
   "e": 241.04,
   "ko": "어떤 반응이 나오는지 살펴보세요.",
   "hi": "어떤 반응"
  },
  {
   "s": 241.04,
   "e": 243.82,
   "ko": "아이가 한국어로 대답할 수도 있고,",
   "hi": "대답할"
  },
  {
   "s": 244.24,
   "e": 246.97,
   "ko": "손가락으로 가리킬 수도 있어요.",
   "hi": "손가락"
  },
  {
   "s": 246.97,
   "e": 248.9,
   "ko": "재미있는 소리를 내거나,",
   "hi": "재미있는 소리"
  },
  {
   "s": 248.9,
   "e": 251.37,
   "ko": "놀이가 전혀 예상하지 못한 방향으로",
   "hi": "예상하지"
  },
  {
   "s": 251.37,
   "e": 252.74,
   "ko": "흘러갈 수도 있죠.",
   "hi": ""
  },
  {
   "s": 252.74,
   "e": 255.7,
   "ko": "그 반응을 받아주며",
   "hi": "받아주며"
  },
  {
   "s": 255.7,
   "e": 257.24,
   "ko": "계속 놀아 주세요.",
   "hi": ""
  },
  {
   "s": 257.24,
   "e": 261.0,
   "ko": "매번 “영어로 말해 봐”라고",
   "hi": "영어로 말해"
  },
  {
   "s": 261.0,
   "e": 263.79,
   "ko": "하지 않으셔도 괜찮아요.",
   "hi": ""
  },
  {
   "s": 264.0,
   "e": 267.44,
   "ko": "실수도 배우는 과정의 일부예요.",
   "hi": "실수도"
  },
  {
   "s": 267.44,
   "e": 270.5,
   "ko": "결국 우리는 그렇게 배우는 거니까요.",
   "hi": "배우는"
  },
  {
   "s": 270.5,
   "e": 271.9,
   "ko": "함께 웃어도 좋고,",
   "hi": "함께"
  },
  {
   "s": 271.9,
   "e": 273.55,
   "ko": "다시 해 봐도 좋아요.",
   "hi": "다시"
  },
  {
   "s": 273.64,
   "e": 276.14,
   "ko": "실수했다면 가볍게 이렇게 말해 보세요.",
   "hi": "가볍게"
  },
  {
   "s": 276.14,
   "e": 279.12,
   "ko": "“앗! 다시 해 볼까?”",
   "hi": "다시"
  },
  {
   "s": 280.7,
   "e": 282.7,
   "ko": "아이에게 배움은",
   "hi": ""
  },
  {
   "s": 282.7,
   "e": 286.27,
   "ko": "계속 이어갈 수 있는 과정이라는 걸 보여주는 거예요.",
   "hi": "이어갈"
  },
  {
   "s": 286.27,
