 "voice": 107.382,
 "captions": [
  {
   "s": 0.0,
   "e": 3.707,
   "text": "영어가 모국어라고 해서\n어린아이를 잘 가르치는 건 아니에요",
   "sec": "hook2"
  },
  {
   "s": 3.727,
   "e": 6.562,
   "text": "실제로 영어교육이나\n유아교육 전공자가 아니어도",
   "sec": "hook2"
  },
  {
   "s": 6.582,
   "e": 8.762,
   "text": "영어를 가르치는\n강사들이 있어요",
   "sec": "hook2"
  },
  {
   "s": 8.782,
   "e": 12.162,
   "text": "제가 영어유아학원에서 근무하면서\n실제로 봤던 일입니다",
   "sec": "hook2"
  },
  {
   "s": 12.182,
   "e": 14.725,
   "text": "오늘은 제가 직접\n아이들을 가르치면서 느꼈던",
   "sec": "intro"
  },
  {
   "s": 14.745,
   "e": 17.889,
   "text": "영유 상담 때 꼭 확인해야 할\n세 가지를 말씀드릴게요",
   "sec": "intro"
  },
  {
   "s": 17.909,
   "e": 19.471,
   "text": "첫 번째, 교재 진도",
   "sec": "p1"
  },
  {
   "s": 19.491,
   "e": 22.535,
   "text": "영유에서는 한두 달 단위로\n교재를 끝내는 경우가 있어요",
   "sec": "p1"
  },
  {
   "s": 22.555,
   "e": 27.053,
   "text": "그런데 중간에 입학한 아이가\n이미 거의 끝나가는 교재를 구매하고",
   "sec": "p1"
  },
  {
   "s": 27.073,
   "e": 30.853,
   "text": "마지막 단원만 공부한 뒤\n집에 가져가는 경우도 있었어요",
   "sec": "p1"
  },
  {
   "s": 30.873,
   "e": 35.071,
   "text": "그래서 중간 입학이라면\n현재 교재가 어디까지 진행됐는지",
   "sec": "p1"
  },
  {
   "s": 35.091,
   "e": 38.053,
   "text": "교재비는 어떻게 책정되는지\n꼭 확인해 보세요",
   "sec": "p1"
  },
  {
   "s": 38.073,
   "e": 40.471,
   "text": "두 번째, 원어민 강사의 교육 경험",
   "sec": "p2"
  },
  {
   "s": 40.491,
   "e": 42.689,
   "text": "물론 전공이 전부는 아니죠",
   "sec": "p2"
  },
  {
   "s": 42.709,
   "e": 47.489,
   "text": "중요한 건 우리 아이 선생님이\n유아교육에 대한 이해가 있는지",
   "sec": "p2"
  },
  {
   "s": 47.509,
   "e": 50.616,
   "text": "아이들을 가르친 경험은\n얼마나 있는지예요",
   "sec": "p2"
  },
  {
   "s": 50.636,
   "e": 54.235,
   "text": "그리고 학원의 교육 방식에 대해\n충분히 교육받고",
   "sec": "p2"
  },
  {
   "s": 54.255,
   "e": 56.689,
   "text": "수업을 진행하는지도\n확인해 보셨으면 좋겠어요",
   "sec": "p2"
  },
  {
   "s": 56.709,
   "e": 58.707,
   "text": "세 번째, 아이들의 하루 일과",
   "sec": "p3"
  },
  {
   "s": 58.727,
   "e": 62.689,
   "text": "놀이형 영유라고 해서\n무조건 뛰어놀기만 하는 건 아니에요",
   "sec": "p3"
  },
  {
   "s": 62.709,
   "e": 66.971,
   "text": "놀이형이라고 하더라도 책상에 앉아\n수업하는 시간이 상당할 수 있거든요",
   "sec": "p3"
  },
  {
   "s": 66.991,
   "e": 69.871,
   "text": "그래서 실제 시간표를 확인하고",
   "sec": "p3"
  },
  {
   "s": 69.891,
   "e": 73.653,
   "text": "아이들이 얼마나 움직이는지,\n자유롭게 노는 시간은 충분한지",
   "sec": "p3"
  },
  {
   "s": 73.673,
   "e": 75.253,
   "text": "살펴보셨으면 좋겠어요",
   "sec": "p3"
  },
  {
   "s": 75.273,
   "e": 77.507,
   "text": "그리고 이건\n제 개인적인 생각인데요",
   "sec": "p4"
  },
  {
   "s": 77.527,
   "e": 80.289,
   "text": "만약 아이가 학습 중심의\n영유에 다니고 있다면",
   "sec": "p4"
  },
  {
   "s": 80.309,
   "e": 83.962,
   "text": "정규 수업 이후까지\n계속 학습을 이어가기보다는",
   "sec": "p4"
  },
  {
   "s": 83.982,
   "e": 87.916,
   "text": "신체 활동이나 자유로운 놀이,\n다양한 경험을 할 수 있는 시간을",
   "sec": "p4"
  },
  {
   "s": 87.936,
   "e": 90.335,
   "text": "만들어 주는 것도\n좋은 방법이라고 생각해요",
   "sec": "p4"
  },
  {
   "s": 90.355,
   "e": 92.78,
   "text": "물론 아이의 체력과\n성향에 따라 다르겠죠",
   "sec": "p4"
  },
  {
   "s": 92.8,
   "e": 96.235,
   "text": "그런데 영유에서 근무하면서 느낀\n중요한 문제가 또 있어요",
   "sec": "next"
  },
  {
   "s": 96.255,
   "e": 98.58,
   "text": "바로 선생님이\n얼마나 자주 바뀌는지",
   "sec": "next"
  },
  {
   "s": 98.6,
   "e": 102.616,
   "text": "그리고 학원 운영진이 아이들 교육을\n얼마나 이해하고 있는지예요",
   "sec": "next"
  },
  {
   "s": 102.636,
   "e": 104.798,
   "text": "이 이야기는 다음 영상에서\n자세히 해볼게요",
   "sec": "next"
  },
  {
   "s": 104.818,
   "e": 107.362,
   "text": "영유에 대해 궁금한 점이 있다면\n댓글로 남겨 주세요!",
   "sec": "end2"
  }
 ],
