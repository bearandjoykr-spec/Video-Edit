 "captions": [
  {
   "s": 0.0,
   "e": 4.08,
   "text": "아이 키우는 부모님들,\n주목하세요! 📢"
  },
  {
   "s": 4.08,
   "e": 8.68,
   "text": "오늘부터 일요일까지 코엑스에서\n유아교육전이 시작됩니다!"
  },
  {
   "s": 8.68,
   "e": 12.74,
   "text": "다양한 프로그램과 그림책,\n그리고 체험까지 직접 만나볼 수 있어요"
  },
  {
   "s": 12.74,
   "e": 18.3,
   "text": "저희와 함께\n가보실까요? 👣"
  },
  {
   "s": 18.63,
   "e": 21.98,
   "text": "제가 오늘 다녀온 꿀팁\n알려드릴게요!"
  },
  {
   "s": 22.23,
   "e": 26.38,
   "text": "선착순 혜택을 원한다면\n오전 10시에 가세요!"
  },
  {
   "s": 26.38,
   "e": 30.13,
   "text": "단, 무료 체험권은\n사전등록자 대상이에요"
  },
  {
   "s": 30.38,
   "e": 34.33,
   "text": "그게 목적이 아니라면\n점심 이후도 추천해요"
  },
  {
   "s": 34.33,
   "e": 38.08,
   "text": "오늘 오전엔\n준비 중인 부스도 있었거든요"
  },
  {
   "s": 38.33,
   "e": 41.08,
   "text": "중앙엔 커피와\n쉴 자리도 있고"
  },
  {
   "s": 41.08,
   "e": 45.43,
   "text": "일부 부스에서는 팔로우 이벤트로\n큰 가방도 줘요"
  },
  {
   "s": 45.68,
   "e": 49.73,
   "text": "무거운 짐은 A홀 근처\n물품보관함에 맡기고"
  },
  {
   "s": 49.73,
   "e": 51.88,
   "text": "쇼핑백 하나\n챙기세요!"
  },
  {
   "s": 52.13,
   "e": 56.48,
   "text": "영어책도 행사 특가로 판매하지만\n사람이 많으니"
  },
  {
   "s": 56.48,
   "e": 59.43,
   "text": "사고 싶은 책은\n미리 정해 오세요!"
  },
  {
   "s": 59.68,
   "e": 64.13,
   "text": "저희가 직접 둘러보고 고른\n추천 교구와 책 TOP 3도"
  },
  {
   "s": 64.13,
   "e": 66.28,
   "text": "곧 소개할 예정이에요!"
  },
  {
   "s": 66.53,
   "e": 69.68,
   "text": "아이 영어교육에 관심 있으시다면"
  },
  {
   "s": 69.68,
   "e": 74.23,
   "text": "베어앤조이 팔로우하고\n다음 영상도 기대해 주세요!"
  },
  {
   "s": 74.48,
   "e": 78.23,
   "text": "이번 주말 방문할\n부모님께 공유해 주세요!"
  }
 ],
