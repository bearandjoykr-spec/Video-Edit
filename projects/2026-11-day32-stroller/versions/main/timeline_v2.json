 "captions": [
  {
   "i": 0,
   "s": 2.4499999999999997,
   "e": 4.314,
   "ko": "아직 말을 시작하지 않은 아기에게",
   "en": "",
   "hi": "아기에게",
   "demo": false,
   "words": []
  },
  {
   "i": 1,
   "s": 4.234,
   "e": 6.13,
   "ko": "영어로는 뭐라고 말하면 좋을까?",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 2,
   "s": 6.05,
   "e": 8.244,
   "ko": "특히 아기랑 단둘이 산책을 하거나",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 3,
   "s": 8.164,
   "e": 9.15,
   "ko": "유모차를 끌 때",
   "en": "",
   "hi": "유모차를 끌 때",
   "demo": false,
   "words": []
  },
  {
   "i": 4,
   "s": 9.07,
   "e": 10.662,
   "ko": "무슨 말을 해야 할지",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 5,
   "s": 10.582,
   "e": 13.26,
   "ko": "막막한 부모님들도 계실 것 같아요.",
   "en": "",
   "hi": "막막한",
   "demo": false,
   "words": []
  },
  {
   "i": 6,
   "s": 13.18,
   "e": 15.86,
   "ko": "그런데 어렵게 생각하지 않으셔도 돼요.",
   "en": "",
   "hi": "어렵게",
   "demo": false,
   "words": []
  },
  {
   "i": 7,
   "s": 15.78,
   "e": 18.116,
   "ko": "지금 아이와 함께 보고 느끼는 것들을",
   "en": "",
   "hi": "보고 느끼는",
   "demo": false,
   "words": []
  },
  {
   "i": 8,
   "s": 18.036,
   "e": 19.83,
   "ko": "영어로 이야기해 보세요.",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 9,
   "s": 19.75,
   "e": 21.59,
   "ko": "유모차를 끌고 출발할 때는",
   "en": "",
   "hi": "출발할 때는",
   "demo": false,
   "words": []
  },
  {
   "i": 10,
   "s": 21.51,
   "e": 24.09,
   "ko": "자, 출발!",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 11,
   "s": 24.01,
   "e": 26.33,
   "ko": "산책하다가 나무를 발견했다면",
