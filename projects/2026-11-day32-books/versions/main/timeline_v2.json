 "captions": [
  {
   "i": 1,
   "s": 2.322,
   "e": 5.46,
   "ko": "공동구매로 영어책도 잔뜩 샀는데",
   "en": "",
   "hi": "잔뜩",
   "demo": false,
   "words": []
  },
  {
   "i": 2,
   "s": 5.38,
   "e": 6.72,
   "ko": "정작 우리 아이는",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 3,
   "s": 6.64,
   "e": 8.41,
   "ko": "그 책을 잘 읽지 않나요?",
   "en": "",
   "hi": "잘 읽지 않나요?",
   "demo": false,
   "words": []
  },
  {
   "i": 4,
   "s": 8.33,
   "e": 10.141,
   "ko": "그렇다면 책을 더 사기 전에",
   "en": "",
   "hi": "더 사기 전에",
   "demo": false,
   "words": []
  },
  {
   "i": 5,
   "s": 10.061,
   "e": 12.17,
   "ko": "꼭 해보셨으면 하는 게 있어요.",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 6,
   "s": 12.09,
   "e": 14.13,
   "ko": "아이와 함께 서점에 가보세요.",
   "en": "",
   "hi": "서점에",
   "demo": false,
   "words": []
  },
  {
   "i": 7,
   "s": 14.05,
   "e": 15.448,
   "ko": "그리고 아이가 직접",
   "en": "",
   "hi": "직접",
   "demo": false,
   "words": []
  },
  {
   "i": 8,
   "s": 15.368,
   "e": 17.74,
   "ko": "읽고 싶은 책을 고르게 해주세요.",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 9,
   "s": 17.66,
   "e": 20.155,
   "ko": "제가 실제로 유아 영어학원에서 일했을 때",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 10,
   "s": 20.075000000000003,
   "e": 22.1,
   "ko": "매일 아침 이렇게 시작했어요.",
   "en": "",
   "hi": "매일 아침",
   "demo": false,
   "words": []
  },
  {
   "i": 11,
   "s": 22.020000000000003,
   "e": 23.464,
   "ko": "아이들이 등원하면",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 12,
   "s": 23.384,
   "e": 25.682,
   "ko": "읽고 싶은 책 두 권을 직접 고르고",
   "en": "",
   "hi": "직접",
   "demo": false,
   "words": []
  },
  {
   "i": 13,
   "s": 25.602,
   "e": 28.41,
   "ko": "나머지 한 권은 제가 추천해 줬거든요.",
   "en": "",
   "hi": "추천해",
   "demo": false,
   "words": []
  },
  {
   "i": 14,
   "s": 28.330000000000002,
   "e": 30.072,
   "ko": "그런데 정말 재미있는 건",
   "en": "",
   "hi": "재미있는",
   "demo": false,
   "words": []
  },
  {
   "i": 15,
   "s": 29.992,
   "e": 31.901,
   "ko": "아이들이 자기가 고른 책을",
   "en": "",
   "hi": "자기가 고른 책을",
   "demo": false,
   "words": []
  },
  {
   "i": 16,
   "s": 31.821,
   "e": 33.92,
   "ko": "계속해서 읽는다는 거예요.",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 17,
   "s": 33.84,
   "e": 35.749,
   "ko": "어떤 아이들은 같은 책을",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 18,
   "s": 35.669000000000004,
   "e": 37.95,
   "ko": "거의 닳도록 매일 읽었어요.",
   "en": "",
   "hi": "닳도록",
   "demo": false,
   "words": []
  },
  {
   "i": 19,
   "s": 37.870000000000005,
   "e": 39.118,
   "ko": "그러다 어느 순간",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 20,
   "s": 39.038000000000004,
   "e": 41.953,
   "ko": "책에 나오는 영어 문장을 통째로 기억하고",
   "en": "",
   "hi": "통째로",
   "demo": false,
   "words": []
  },
  {
   "i": 21,
   "s": 41.873000000000005,
   "e": 44.789,
   "ko": "일상에서도 자연스럽게 사용하는 모습을",
   "en": "",
   "hi": "자연스럽게",
   "demo": false,
   "words": []
  },
  {
   "i": 22,
   "s": 44.709,
   "e": 45.82,
   "ko": "여러 번 봤어요.",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 23,
   "s": 45.74,
   "e": 47.31,
   "ko": "그때 다시 느꼈어요.",
   "en": "",
   "hi": "다시 느꼈어요.",
   "demo": false,
   "words": []
  },
  {
   "i": 24,
   "s": 47.230000000000004,
   "e": 48.732,
   "ko": "아이에게 중요한 건",
   "en": "",
   "hi": "중요한 건",
   "demo": false,
   "words": []
  },
  {
   "i": 25,
   "s": 48.652,
   "e": 51.043,
   "ko": "얼마나 많은 책을 사주느냐보다",
   "en": "",
   "hi": "많은 책을",
   "demo": false,
   "words": []
  },
  {
   "i": 26,
   "s": 50.963,
   "e": 53.71,
   "ko": "그 책을 얼마나 좋아하느냐는 거예요.",
   "en": "",
   "hi": "얼마나 좋아하느냐는",
   "demo": false,
   "words": []
  },
  {
   "i": 27,
   "s": 53.63,
   "e": 56.616,
   "ko": "이번 주말에는 아이와 서점에 가서",
   "en": "",
   "hi": "서점에",
   "demo": false,
   "words": []
  },
  {
   "i": 28,
   "s": 56.536,
   "e": 59.107,
   "ko": "좋아하는 영어 그림책 한 권을",
   "en": "",
   "hi": "한 권을",
   "demo": false,
   "words": []
  },
  {
   "i": 29,
   "s": 59.027,
   "e": 61.57,
   "ko": "직접 골라보는 건 어떠세요?",
   "en": "",
   "hi": "직접",
   "demo": false,
   "words": []
  },
  {
   "i": 30,
   "s": 61.49,
   "e": 65.407,
   "ko": "어떤 영어 그림책을 골라야 할지 고민되신다면",
   "en": "",
   "hi": "고민되신다면",
   "demo": false,
   "words": []
  },
  {
   "i": 31,
   "s": 65.327,
   "e": 67.225,
   "ko": "곧 영국인 마크와 제가",
   "en": "",
   "hi": "마크와",
   "demo": false,
   "words": []
  },
  {
   "i": 32,
   "s": 67.145,
   "e": 70.456,
   "ko": "아이들과 함께 읽기 좋은 영어 그림책을",
   "en": "",
   "hi": "",
   "demo": false,
   "words": []
  },
  {
   "i": 33,
   "s": 70.376,
   "e": 71.99,
   "ko": "소개해 드릴게요.",
   "en": "",
   "hi": "소개해",
   "demo": false,
   "words": []
  },
  {
   "i": 34,
   "s": 71.91,
   "e": 74.007,
   "ko": "베어앤조이를 팔로우하고",
   "en": "",
