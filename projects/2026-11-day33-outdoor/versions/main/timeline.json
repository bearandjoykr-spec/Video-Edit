  },
  {
   "s": 9.02,
   "e": 13.22,
   "ko": "함께 영어를 써볼\n정말 좋은 기회예요.",
   "en": ""
  },
  {
   "s": 13.22,
   "e": 16.27,
   "ko": "아이와 함께 쓸 수 있는 말을\n알려드릴게요.",
   "en": ""
  },
  {
   "s": 16.27,
   "e": 21.37,
   "ko": "첫 번째,\n보이는 것에 따라 이렇게 말해요.",
   "en": ""
  },
  {
   "s": 21.37,
   "e": 23.67,
   "ko": "봐, 자동차야!",
   "en": ""
  },
  {
   "s": 23.67,
   "e": 25.67,
   "ko": "봐, 배야!",
   "en": ""
  },
  {
   "s": 25.67,
   "e": 28.12,
   "ko": "봐, 물고기야!\n(강가에 있다면요)",
   "en": ""
  },
  {
   "s": 28.12,
   "e": 33.32,
   "ko": "두 번째,\n'Do you like ~?'",
   "en": ""
  },
  {
   "s": 33.32,
   "e": 35.27,
   "ko": "풀 좋아해?",
   "en": ""
  },
  {
   "s": 35.27,
   "e": 36.22,
   "ko": "나무 좋아해?",
   "en": ""
  },
  {
   "s": 36.22,
   "e": 38.82,
   "ko": "좋아하는 건 뭐든\n넣어서 물어보세요!",
   "en": ""
  },
  {
   "s": 38.82,
   "e": 43.77,
   "ko": "마지막으로, 여기는 한국이니까\n이렇게 물어볼래요.",
   "en": ""
  },
  {
   "s": 43.77,
   "e": 47.67,
   "ko": "배고파?\n배고프니?",
   "en": ""
  },
  {
   "s": 47.67,
   "e": 51.72,
   "ko": "서울에서 저를 보면\n이렇게 물어봐 주세요.",
