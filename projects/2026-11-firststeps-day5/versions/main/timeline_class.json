   "speaker": "joy"
  },
  {
   "s": 200.0,
   "e": 202.9,
   "ko": "라고 말이죠.",
   "hi": "",
   "en": "Let's look together!",
   "speaker": "joy"
  },
  {
   "s": 203.0,
   "e": 207.1,
   "ko": "그리고 부모님과 함께 그림을 천천히 살펴보다가",
