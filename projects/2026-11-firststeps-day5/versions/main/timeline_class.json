 "captions": [
  {
   "s": 0.1,
   "e": 6.0,
   "ko": "안녕하세요, 5일차에 오신 걸 환영해요!",
   "hi": "5일차",
   "en": "Hello, and welcome to Day 5.",
   "speaker": "mark"
  },
  {
   "s": 6.2,
   "e": 10.9,
   "ko": "오늘은 우리가 이야기 탐정이 돼 볼 거예요.",
   "hi": "이야기 탐정",
   "en": "Today we're becoming story detectives.",
   "speaker": "mark"
  },
  {
   "s": 11.1,
   "e": 15.6,
   "ko": "자세히 들여다보고, 작은 것들을 발견하고,",
   "hi": "자세히",
   "en": "We're going to look closely, notice little things,",
   "speaker": "mark"
  },
  {
   "s": 15.8,
   "e": 19.0,
   "ko": "함께 찾아내는 즐거움을 누려 봐요.",
   "hi": "즐거움",
   "en": "and enjoy discovering them together.",
   "speaker": "mark"
  },
  {
   "s": 19.2,
   "e": 21.7,
   "ko": "그거 아세요?",
   "hi": "",
   "en": "You see?",
   "speaker": "mark"
  },
  {
   "s": 21.8,
   "e": 25.9,
   "ko": "아이가 여러분도 못 본 걸 먼저 찾을지도 몰라요.",
   "hi": "먼저",
   "en": "Your child might spot something you haven't even noticed,",
   "speaker": "mark"
  },
  {
   "s": 26.0,
   "e": 28.833,
   "ko": "아이가 여러분을 놀라게 해 주도록 두세요.",
   "hi": "놀라게",
   "en": "so let them surprise you.",
   "speaker": "mark"
  },
  {
   "s": 28.9,
   "e": 34.0,
   "ko": "먼저 세 가지 표현을 연습해 볼게요.",
   "hi": "세 가지",
   "en": "So first, let's practise our three phrases.",
   "speaker": "mark"
  },
  {
   "s": 35.1,
   "e": 38.1,
   "ko": "첫 번째 표현은,",
   "hi": "첫 번째",
   "en": "So our first phrase is,",
   "speaker": "mark"
  },
  {
   "s": 40.8,
   "e": 42.6,
   "ko": "천천히 들어보세요.",
   "hi": "천천히",
   "en": "Listen slowly.",
   "speaker": "mark"
  },
  {
   "s": 46.0,
   "e": 48.2,
   "ko": "이번엔 따라 해보세요.",
   "hi": "따라",
   "en": "Now you try.",
   "speaker": "mark"
  },
  {
   "s": 51.8,
   "e": 53.4,
   "ko": "좋아요!",
   "hi": "좋아요",
   "en": "Good.",
   "speaker": "mark"
  },
  {
   "s": 53.5,
   "e": 56.5,
   "ko": "'can'은 짧고 부드럽게,",
   "hi": "짧고",
   "en": "Keep 'can' soft and quick,",
   "speaker": "mark"
  },
  {
   "s": 56.6,
   "e": 59.4,
   "ko": "'see'는 또렷하게 들리게 해요.",
   "hi": "또렷하게",
   "en": "and let 'see' stand out.",
   "speaker": "mark"
  },
  {
   "s": 59.5,
   "e": 62.2,
   "ko": "조금씩 늘려 가며 말해요.",
   "hi": "조금씩",
   "en": "I can… I can see…",
   "speaker": "mark"
  },
  {
   "s": 68.7,
   "e": 73.7,
   "ko": "좋아요! 내가 발견한 걸 나누는 말이에요.",
   "hi": "나누는",
   "en": "Good. So you're sharing something you've noticed.",
   "speaker": "mark"
  },
  {
   "s": 75.4,
   "e": 78.0,
   "ko": "다음 표현은,",
   "hi": "다음",
   "en": "Okay. Our next phrase is,",
   "speaker": "mark"
  },
  {
   "s": 83.4,
   "e": 85.8,
   "ko": "다시 들어보세요.",
   "hi": "다시",
   "en": "Listen again.",
   "speaker": "mark"
  },
  {
   "s": 88.6,
   "e": 91.3,
   "ko": "자, 여러분 차례예요.",
   "hi": "차례",
   "en": "Okay, your turn.",
   "speaker": "mark"
  },
  {
   "s": 94.2,
   "e": 98.4,
   "ko": "'can you'는 부드럽게 이어서 말해요.",
   "hi": "이어서",
   "en": "Let 'can you' flow together softly.",
   "speaker": "mark"
  },
  {
   "s": 100.5,
   "e": 103.2,
   "ko": "궁금한 마음으로 묻고,",
   "hi": "궁금한",
   "en": "Ask with curiosity,",
   "speaker": "mark"
  },
  {
   "s": 103.3,
   "e": 107.1,
   "ko": "잠깐 기다려 주세요.",
   "hi": "기다려",
   "en": "then leave a little space.",
   "speaker": "mark"
  },
  {
   "s": 107.2,
   "e": 110.6,
   "ko": "아이가 말로 대답하지 않을 수도 있어요.",
   "hi": "말로",
   "en": "Your child might not answer with words.",
   "speaker": "mark"
  },
  {
   "s": 110.7,
   "e": 114.9,
   "ko": "몸짓이나 손가락으로 가리켜도 충분해요.",
   "hi": "충분해요",
   "en": "A gesture or pointing a finger is just as good.",
   "speaker": "mark"
  },
  {
   "s": 116.4,
   "e": 118.8,
   "ko": "마지막 표현은,",
   "hi": "마지막",
   "en": "Our last phrase,",
   "speaker": "mark"
  },
  {
   "s": 122.4,
   "e": 124.3,
   "ko": "천천히 들어보세요.",
   "hi": "천천히",
   "en": "Listen slowly.",
   "speaker": "mark"
  },
  {
   "s": 128.0,
   "e": 130.0,
   "ko": "이번엔 따라 해보세요.",
   "hi": "따라",
   "en": "Now you try.",
   "speaker": "mark"
  },
  {
   "s": 132.7,
   "e": 136.8,
   "ko": "'together'는 가운데를 힘주어 말해요.",
   "hi": "가운데",
   "en": "In 'together', stress the middle part.",
