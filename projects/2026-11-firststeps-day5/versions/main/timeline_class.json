   "hi": "세 가지",
   "en": "Okay, let's say all three.",
   "speaker": "mark"
  },
  {
   "s": 158.5,
   "e": 160.2,
   "ko": "아주 좋아요!",
   "hi": "좋아요",
   "en": "Lovely.",
   "speaker": "mark"
  },
  {
