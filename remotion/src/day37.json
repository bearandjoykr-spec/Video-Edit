 "captions": [
  {
   "s": 0.0,
   "e": 2.807,
   "text": "영유에 새로 들어온 아이가\n교재비는 다 냈는데",
   "sec": "hook"
  },
  {
   "s": 2.827,
   "e": 6.762,
   "text": "정작 몇 페이지만 공부하고\n새 책 그대로 집에 가져간다면?",
   "sec": "hook"
  },
  {
   "s": 6.782,
   "e": 10.144,
   "text": "영유 상담 때 꼭 확인해야 할\n세 가지를 말씀드릴게요",
   "sec": "intro"
  },
  {
   "s": 10.164,
   "e": 11.525,
   "text": "첫 번째, 교재 진도",
   "sec": "p1"
  },
  {
   "s": 11.545,
   "e": 15.107,
   "text": "중간 입학이라면 지금 교재가\n어디까지 진행됐는지",
   "sec": "p1"
  },
  {
   "s": 15.127,
   "e": 18.035,
   "text": "교재비는 어떻게 책정되는지\n꼭 확인해 보세요",
   "sec": "p1"
  },
  {
   "s": 18.055,
   "e": 21.035,
   "text": "영유에 대해 궁금한 점은\n댓글로 남겨 주세요",
   "sec": "end1"
  },
  {
   "s": 21.055,
   "e": 22.071,
   "text": "그럼 안녕! 👋",
   "sec": "end1"
  }
 ],
