 "captions": [
  {
   "s": 0.0,
   "e": 2.807,
   "text": "영유에 새로 들어온 아이가\n교재비는 다 냈는데",
   "sec": "hook"
  },
  {
   "s": 2.827,
   "e": 6.762,
   "text": "정작 몇 페이지만 공부하고\n새 책 그대로 집에 가져간다면?",
   "sec": "hook"
  },
  {
   "s": 6.782,
   "e": 10.144,
   "text": "영유 상담 때 꼭 확인해야 할\n세 가지를 말씀드릴게요",
   "sec": "intro"
  },
  {
   "s": 10.164,
   "e": 11.525,
   "text": "첫 번째, 교재 진도",
   "sec": "p1"
  },
  {
   "s": 11.545,
   "e": 15.107,
   "text": "중간 입학이라면 지금 교재가\n어디까지 진행됐는지",
   "sec": "p1"
  },
  {
   "s": 15.127,
   "e": 18.035,
   "text": "교재비는 어떻게 책정되는지\n꼭 확인해 보세요",
   "sec": "p1"
  },
  {
   "s": 18.055,
   "e": 20.544,
   "text": "두 번째, 원어민 강사의 교육 경험",
   "sec": "p2"
  },
  {
   "s": 20.564,
   "e": 24.089,
   "text": "영어가 모국어라고 해서\n어린아이를 잘 가르치는 건 아니에요",
   "sec": "p2"
  },
  {
   "s": 24.109,
   "e": 28.762,
   "text": "중요한 건 유아교육에 대한\n이해가 있는지",
   "sec": "p2"
  },
  {
   "s": 28.782,
   "e": 31.653,
   "text": "아이들을 가르친 경험이\n얼마나 있는지예요",
   "sec": "p2"
  },
  {
   "s": 31.673,
   "e": 33.489,
   "text": "세 번째, 아이들의 하루 일과",
   "sec": "p3"
  },
  {
   "s": 33.509,
   "e": 36.962,
   "text": "'놀이형'이라고 해서\n무조건 뛰어놀기만 하는 건 아니에요",
   "sec": "p3"
  },
  {
   "s": 36.982,
   "e": 39.862,
   "text": "실제 우리 아이의\n시간표를 꼭 확인하시고",
   "sec": "p3"
  },
  {
   "s": 39.882,
   "e": 45.135,
   "text": "얼마나 움직이는지, 자유롭게 노는\n시간은 충분한지 살펴보세요",
   "sec": "p3"
  },
  {
   "s": 45.155,
   "e": 48.135,
   "text": "영유에 대해 궁금한 점은\n댓글로 남겨 주세요",
   "sec": "end2"
  },
  {
   "s": 48.155,
   "e": 49.171,
   "text": "그럼 안녕! 👋",
   "sec": "end2"
  }
 ],
