 "captions": [
  {
   "s": 0.05,
   "e": 2.65,
   "text": "아이 키우는 부모님들,\n주목하세요! 📢"
  },
  {
   "s": 2.65,
   "e": 6.55,
   "text": "오늘부터 일요일까지 코엑스에서\n유아교육전이 시작됩니다!"
  },
  {
   "s": 6.55,
   "e": 10.75,
   "text": "다양한 프로그램과 그림책,\n그리고 체험까지 직접 만나볼 수 있어요"
  },
  {
   "s": 10.75,
   "e": 12.5,
   "text": "저희와 함께\n가보실까요? 👣"
  },
  {
   "s": 12.56,
   "e": 15.33,
   "text": "저희가 오늘 다녀온 꿀팁\n알려드릴게요!"
  },
  {
   "s": 15.33,
   "e": 19.45,
   "text": "선착순 혜택을 원한다면\n오전 10시 오픈할 때 가세요!"
  },
  {
   "s": 19.45,
   "e": 23.07,
   "text": "단, 무료 체험권은\n사전등록자 대상이에요"
  },
  {
   "s": 23.07,
   "e": 26.76,
   "text": "그게 목적이 아니라면\n점심 이후로도 추천드려요"
  },
  {
   "s": 26.79,
   "e": 30.01,
   "text": "왜냐하면 오늘 오전에\n준비 중인 부스도 있었거든요"
  },
  {
   "s": 30.01,
   "e": 32.81,
   "text": "중앙에는 커피와 쉴 자리도\n정말 많이 있고"
  },
  {
   "s": 32.84,
   "e": 37.73,
   "text": "일부 부스에는 팔로우 이벤트로\n작은 기념품과 가방도 선물로 줘요"
  },
  {
   "s": 37.76,
   "e": 40.87,
   "text": "무거운 짐은 A홀 근처\n물품보관함에 맡기고"
  },
  {
   "s": 40.9,
   "e": 42.75,
   "text": "쇼핑백 하나\n챙기세요!"
  },
  {
   "s": 42.75,
   "e": 46.2,
   "text": "영어책도 행사 특가로 판매하지만\n사람이 정말 많으니"
  },
  {
   "s": 46.23,
   "e": 49.61,
   "text": "사고 싶은 책은 미리\n정해 오시는 걸 추천드려요"
  },
  {
   "s": 49.61,
   "e": 54.0,
   "text": "저희가 직접 둘러보고 고른\n추천 교구와 책 TOP 3도"
  },
  {
   "s": 54.03,
   "e": 56.29,
   "text": "곧 소개할 예정이니\n기다려 주세요!"
  },
  {
   "s": 56.32,
   "e": 58.14,
   "text": "아이 영어교육에\n관심 있으시다면"
  },
  {
   "s": 58.17,
   "e": 62.07,
   "text": "베어앤조이를 팔로우하고\n다음 영상도 기대해 주세요!"
  },
  {
   "s": 62.1,
   "e": 66.37,
   "text": "이번 주말 방문할 친구나 부모님께\n이 영상을 공유해 주세요!"
  },
  {
   "s": 66.37,
   "e": 68.19,
   "text": "그럼 내일 만나요, 안녕! 👋"
  }
 ],
