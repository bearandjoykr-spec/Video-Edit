{
 "fps": 30,
 "day": 38,
 "media": "day38",
 "duration": 126.318,
 "frames": 3790,
 "captions": [
  {
   "s": 0.0,
   "e": 3.435,
   "text": "우리 아이가 다니는 영유에서\n선생님이 자주 바뀐다면?",
   "sec": "hook"
  },
  {
   "s": 3.455,
   "e": 5.725,
   "text": "지난 영상에 이어, 오늘도",
   "sec": "intro"
  },
  {
   "s": 5.745,
   "e": 8.607,
   "text": "영유 상담 때 꼭 확인해야 할\n세 가지 말씀드릴게요",
   "sec": "intro"
  },
  {
   "s": 8.627,
   "e": 11.098,
   "text": "첫 번째, 교사의 근속 기간",
   "sec": "p1"
  },
  {
   "s": 11.118,
   "e": 14.662,
   "text": "아이들에게 선생님은 단순히\n영어를 가르치는 사람이 아니라",
   "sec": "p1"
  },
  {
   "s": 14.682,
   "e": 17.38,
   "text": "매일 만나고 관계를\n쌓아가는 사람이에요",
   "sec": "p1"
  },
  {
   "s": 17.4,
   "e": 21.135,
   "text": "그런데 선생님이 자주 바뀐다면\n아이들은 새로운 선생님에게",
   "sec": "p1"
  },
  {
   "s": 21.155,
   "e": 23.662,
   "text": "적응하는 과정을\n반복해야 할 수도 있어요",
   "sec": "p1"
  },
  {
   "s": 23.682,
   "e": 28.289,
   "text": "상담하실 때 선생님들이 평균적으로\n얼마나 오래 근무하시는지",
   "sec": "p1"
  },
  {
   "s": 28.309,
   "e": 32.962,
   "text": "교사가 바뀐다면 아이들의 특성과\n수업 내용은 어떻게 인수인계되는지",
   "sec": "p1"
  },
  {
   "s": 32.982,
   "e": 33.38,
   "text": "꼭 물어보세요",
   "sec": "p1"
  },
  {
   "s": 33.4,
   "e": 34.953,
   "text": "두 번째, 교과서",
   "sec": "p2"
  },
  {
   "s": 34.973,
   "e": 38.135,
   "text": "상담을 가면 '우리 원은\n미국 교과서를 사용한다'",
   "sec": "p2"
  },
  {
   "s": 38.155,
   "e": 42.698,
   "text": "혹은 '영국 교과서를 사용한다'는\n이야기를 들으실 수도 있어요",
   "sec": "p2"
  },
  {
   "s": 42.718,
   "e": 47.171,
   "text": "하지만 유명한 교과서를 쓴다고\n반드시 좋은 수업이 되는 건 아니에요",
   "sec": "p2"
  },
  {
   "s": 47.191,
   "e": 50.507,
   "text": "교과서 속 영어 문장을 읽고\n문제를 푸는 것과",
   "sec": "p2"
  },
  {
   "s": 50.527,
   "e": 54.371,
   "text": "그 영어를 이해하고 일상에서\n사용하는 것은 다르거든요",
   "sec": "p2"
  },
  {
   "s": 54.391,
   "e": 56.935,
   "text": "그래서 어떤 교재를 쓰는지만\n확인하지 마시고",
   "sec": "p2"
  },
  {
   "s": 56.955,
   "e": 59.325,
   "text": "그 교재로 어떤 활동을 하는지",
   "sec": "p2"
  },
  {
   "s": 59.345,
   "e": 63.28,
   "text": "배운 영어를 직접 써 볼 기회가\n얼마나 있는지 물어보세요",
   "sec": "p2"
  },
  {
   "s": 63.3,
   "e": 65.935,
   "text": "세 번째, 학원 운영진의 소통 방식",
   "sec": "p3"
  },
  {
   "s": 65.955,
   "e": 70.035,
   "text": "이건 제가 근무하면서 정말\n중요하다고 느낀 부분이에요",
   "sec": "p3"
  },
  {
   "s": 70.055,
   "e": 73.035,
   "text": "학부모님의 의견이\n여러 사람을 거쳐 전달되면",
   "sec": "p3"
  },
  {
   "s": 73.055,
   "e": 76.889,
   "text": "정작 수업하는 원어민 강사에게는\n내용이 다르게 전달되거나",
   "sec": "p3"
  },
  {
   "s": 76.909,
   "e": 79.871,
   "text": "문제가 충분히 해결되지 않는\n경우도 봤어요",
   "sec": "p3"
  },
  {
   "s": 79.891,
   "e": 84.144,
   "text": "그래서 원장님이나 운영진이\n원어민 강사와 원활하게 소통하는지",
   "sec": "p3"
  },
  {
   "s": 84.164,
   "e": 88.089,
   "text": "학부모님의 의견이 실제 수업에\n어떻게 반영되는지 꼭 확인해 주세요",
   "sec": "p3"
  },
  {
   "s": 88.109,
   "e": 90.435,
   "text": "그리고 꼭 말씀드리고 싶은 게 있어요",
   "sec": "last"
  },
  {
   "s": 90.455,
   "e": 94.462,
   "text": "영어를 배우기 위해 반드시\n영유를 다녀야 한다고 생각하진 않아요",
   "sec": "last"
  },
  {
   "s": 94.482,
   "e": 97.98,
   "text": "하지만 모든 영유가\n같은 교육을 제공하는 것도 아니고",
   "sec": "last"
  },
  {
   "s": 98.0,
   "e": 101.853,
   "text": "아이마다 잘 맞는\n교육 환경도 다를 수 있어요",
   "sec": "last"
  },
  {
   "s": 101.873,
   "e": 103.916,
   "text": "영유를 선택하신다면,\n혹은 이미 다니고 있다면",
   "sec": "last"
  },
  {
   "s": 103.936,
   "e": 107.316,
   "text": "유명한 교재나 화려한 시설보다",
   "sec": "last"
  },
  {
   "s": 107.336,
   "e": 110.489,
   "text": "우리 아이가 매일 어떤 선생님과\n어떤 환경에서 시간을 보내는지",
   "sec": "last"
  },
  {
   "s": 110.509,
   "e": 112.462,
   "text": "확인해 주셨으면 좋겠어요",
   "sec": "last"
  },
  {
   "s": 112.482,
   "e": 115.78,
   "text": "결국 중요한 건 어디에서\n영어를 배우느냐보다",
   "sec": "last"
  },
  {
   "s": 115.8,
   "e": 117.48,
   "text": "어떤 경험을 통해\n영어를 배우느냐니까요",
   "sec": "last"
  },
  {
   "s": 117.5,
   "e": 120.58,
   "text": "관련해서 더 궁금한 점이 있다면\n댓글로 남겨 주세요",
   "sec": "end"
  },
  {
   "s": 120.6,
   "e": 125.298,
   "text": "제가, 혹은 원어민 마크가 경험했던\n이야기를 바탕으로 함께 나눠볼게요",
   "sec": "end"
  }
 ],
