 "captions": [
  {
   "s": 0.0,
   "e": 3.735,
   "text": "우리 아이가 다니는 영유에서\n선생님이 자주 바뀐다면?",
   "sec": "hook"
  },
  {
   "s": 3.755,
   "e": 5.98,
   "text": "지난 영상에 이어, 오늘도",
   "sec": "intro"
  },
  {
   "s": 6.0,
   "e": 9.216,
   "text": "영유 상담 때 꼭 확인해야 할\n세 가지 말씀드릴게요",
   "sec": "intro"
  },
  {
   "s": 9.236,
   "e": 12.08,
   "text": "첫 번째, 교사의 근속 기간",
   "sec": "p1"
  },
  {
   "s": 12.1,
   "e": 15.244,
   "text": "아이들에게 선생님은 단순히\n영어를 가르치는 사람이 아니라",
   "sec": "p1"
  },
  {
   "s": 15.264,
   "e": 18.262,
   "text": "매일 만나고 관계를\n쌓아가는 사람이에요",
   "sec": "p1"
  },
  {
   "s": 18.282,
   "e": 21.625,
   "text": "그런데 선생님이 자주 바뀐다면\n아이들은 새로운 선생님에게",
   "sec": "p1"
  },
  {
   "s": 21.645,
   "e": 24.271,
   "text": "적응하는 과정을\n반복해야 할 수도 있어요",
   "sec": "p1"
  },
  {
   "s": 24.291,
   "e": 29.171,
   "text": "상담하실 때 선생님들이 평균적으로\n얼마나 오래 근무하시는지",
   "sec": "p1"
  },
  {
   "s": 29.191,
   "e": 33.635,
   "text": "교사가 바뀐다면 아이들의 특성과\n수업 내용은 어떻게 인수인계되는지",
   "sec": "p1"
  },
  {
   "s": 33.655,
   "e": 34.535,
   "text": "꼭 물어보세요",
   "sec": "p1"
  },
  {
   "s": 43.055,
   "e": 44.845,
   "text": "그럼 내일 만나요, 안녕! 👋",
   "sec": "bye"
  }
 ],
