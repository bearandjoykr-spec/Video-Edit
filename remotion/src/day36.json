 "captions": [
  {
   "s": 3.95,
   "e": 7.9,
   "text": "교구와 그림책 TOP 3,\n함께 소개해드릴게요",
   "ko": "",
   "who": "Joy"
  },
  {
   "s": 9.4,
   "e": 12.669,
   "text": "사람이 제일 많았던 곳,\n바로 영어책 코너!",
   "vo": true
  },
  {
   "s": 12.669,
   "e": 16.504,
   "text": "소리책, 팝업북도 좋지만\n고를 땐 꼭 펼쳐 보세요",
   "vo": true
  },
  {
   "s": 16.504,
   "e": 20.339,
   "text": "바로 말해 줄 문장이 있는 책이\n제일 오래 쓰여요",
   "vo": true
  },
  {
   "s": 22.0,
   "e": 26.024,
   "text": "직접 누르면 소리가 나서\n새 단어를 스스로 익혀요",
   "vo": true
  },
  {
   "s": 26.024,
   "e": 29.292,
   "text": "집이나 어린이집\n환경 구성에 딱이에요",
   "vo": true
  },
  {
   "s": 29.55,
   "e": 30.3,
   "text": "Brilliant! 👏",
   "ko": "",
   "who": "Mark"
  },
  {
   "s": 33.3,
   "e": 37.701,
   "text": "아이들은 앉아서 공부할 때보다\n놀 때 훨씬 빨리 배워요",
   "vo": true
  },
  {
   "s": 37.701,
   "e": 40.026,
   "text": "놀면서 이렇게 말해 주세요",
   "vo": true
  },
  {
   "s": 40.0,
   "e": 41.5,
